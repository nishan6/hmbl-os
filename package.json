{
  "name": "hmbl-os",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:perf": "vitest run --project perf",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore-check": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/restore-check.ts",
    "postinstall": "prisma generate",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "user:create": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/create-user.ts",
    "notifications:run": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/run-notifications.ts",
    "readiness": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/readiness.ts",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
