# HMBL OS environment template.
# Copy to .env for local development: cp .env.example .env
# Never commit .env or real credentials. Production values live in the host's secret store.

# development | test | production
APP_ENV=development

# Postgres started by `docker compose up -d` (see docker-compose.yml).
DATABASE_URL=postgresql://hmbl:hmbl@localhost:5432/hmbl_dev

# Separate database for automated tests. Tests refuse to run against DATABASE_URL.
TEST_DATABASE_URL=postgresql://hmbl:hmbl@localhost:5432/hmbl_test

# Public base URL of the app.
APP_URL=http://localhost:3000

# Signs session cookies. Use a different value in every environment.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# debug | info | warn | error
LOG_LEVEL=info

# Folder for uploaded documents, relative to the app folder or absolute.
# Back it up together with the database (see docs/running-locally.md).
STORAGE_DIR=storage
