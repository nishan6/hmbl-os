// HMBL OS database schema.
// Every change goes through a reviewed migration: `pnpm db:migrate:dev --name <change>`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (tables required by Better Auth) ────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

// STAFF sign in to HMBL OS. EXTERNAL people (client contacts, vendors and
// freelancers) sign in to the portal only and can never hold a role
// (docs/portal.md); a database trigger enforces both.
enum UserKind {
  STAFF
  EXTERNAL
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  image            String?
  // DISABLED users cannot start a session; existing sessions are revoked on disable.
  status           UserStatus @default(ACTIVE)
  kind             UserKind   @default(STAFF)
  // Set by Better Auth once an authenticator app is verified.
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions               Session[]
  accounts               Account[]
  ownedClients           Client[]
  twoFactors             TwoFactor[]
  roles                  UserRole[]                   @relation("UserRoles")
  grants                 UserRole[]                   @relation("UserRoleGrantedBy")
  opportunities          Opportunity[]
  crmActivities          CrmActivity[]
  quotes                 Quote[]                      @relation("QuoteOwner")
  quotesCreated          Quote[]                      @relation("QuoteCreatedBy")
  quoteSteps             QuoteApprovalStep[]
  projectsCreated        Project[]                    @relation("ProjectCreatedBy")
  projectsManaged        Project[]                    @relation("ProjectManager")
  projectsProduced       Project[]                    @relation("ProjectProducer")
  projectCosts           ProjectCostEntry[]           @relation("ProjectCostCreatedBy")
  changeOrders           ProjectChangeOrder[]         @relation("ChangeOrderCreatedBy")
  scheduleItemsCreated   ProjectScheduleItem[]        @relation("ScheduleItemCreatedBy")
  scheduleItemsCompleted ProjectScheduleItem[]        @relation("ScheduleItemCompletedBy")
  resourcesCreated       ProjectResourceRequirement[] @relation("ResourceCreatedBy")
  documentsUploaded      RecordDocument[]             @relation("DocumentUploadedBy")
  notifications          Notification[]               @relation("Notifications")
  notificationPrefs      NotificationPreference[]     @relation("NotificationPreferences")
  journalsCreated        Journal[]                    @relation("JournalCreatedBy")
  expenseClaims          ExpenseClaim[]               @relation("ExpenseClaimant")
  staffAdvances          StaffAdvance[]               @relation("StaffAdvancePerson")
  crewMember             CrewMember?                  @relation("CrewMemberUser")
  portalAccount          PortalAccount?               @relation("PortalAccountUser")
  portalInvitesSent      PortalInvitation[]           @relation("PortalInvitedBy")
  portalAccountsRevoked  PortalAccount[]              @relation("PortalAccountRevokedBy")
  portalShares           PortalShare[]                @relation("PortalSharedBy")
  portalSharesRevoked    PortalShare[]                @relation("PortalShareRevokedBy")
  quotePortalResponses   QuotePortalResponse[]        @relation("QuotePortalResponder")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

// Authenticator-app secret and backup codes, both encrypted with BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // False until the user proves the app works by entering a code.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Roles and permissions ────────────────────────────────────────────────────

// A role is a named set of permission keys from src/server/permissions/catalog.ts.
// System roles are created by the seed/bootstrap and can be edited but not deleted.
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @db.Uuid
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
  @@map("role_permissions")
}

// A role granted to a user. With legalEntityId set, the role applies to that
// legal entity only; null means every entity, including ones added later.
model UserRole {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String       @db.Uuid
  role          Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  legalEntityId String?      @db.Uuid
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  grantedById   String?      @db.Uuid
  grantedBy     User?        @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  // A role is granted at most once per user per scope. Two indexes because a
  // plain unique index treats NULL ("all entities") values as distinct.
  @@unique([userId, roleId, legalEntityId])
  @@unique([userId, roleId], map: "user_roles_userId_roleId_all_entities_key", where: raw("\"legalEntityId\" IS NULL"))
  @@index([userId])
  @@index([roleId])
  @@index([legalEntityId])
  @@map("user_roles")
}

// ─── Organisation structure ───────────────────────────────────────────────────
// The deployment itself is the group (HMBL Group). Shared master data never
// implies shared accounting ownership: anything financial belongs to exactly
// one legal entity.

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

// A company with its own books, tax registrations and base currency.
model LegalEntity {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  legalName    String
  tradingName  String?
  countryCode  String       @db.Char(2) // ISO 3166-1 alpha-2
  baseCurrency String       @db.Char(3) // ISO 4217
  timezone     String // IANA zone, e.g. Asia/Kolkata
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String? // State or province; for India, the GST state
  postalCode   String?
  status       RecordStatus @default(ACTIVE)
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  taxRegistrations TaxRegistration[]
  numberingSchemes NumberingScheme[]
  costCentres      CostCentre[]
  locations        Location[]
  userRoles        UserRole[]
  opportunities    Opportunity[]
  quotes           Quote[]
  commercial       CommercialSettings?
  projects         Project[]
  financeSettings  FinanceSettings?
  invoiceServices  InvoiceService[]
  ledgerAccounts   LedgerAccount[]
  periods          AccountingPeriod[]
  journals         Journal[]
  salesInvoices    SalesInvoice[]
  creditNotes      CreditNote[]
  bankAccounts     BankAccount[]
  receipts         Receipt[]
  vendorBills      VendorBill[]
  vendorPayments   VendorPayment[]
  staffAdvances    StaffAdvance[]
  expenseClaims    ExpenseClaim[]
  equipmentAssets  EquipmentAsset[]
  purchaseOrders   PurchaseOrder[]
  procurement      ProcurementSettings?
  travelRequests   TravelRequest[]
  shipments        Shipment[]
  documents        RecordDocument[]

  @@map("legal_entities")
}

// A tax or statutory identifier held by a legal entity (GSTIN, PAN, TAN, VAT…).
// Types are free text so new jurisdictions need configuration, not code.
model TaxRegistration {
  id            String       @id @default(uuid()) @db.Uuid
  legalEntityId String       @db.Uuid
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  type          String
  value         String
  region        String?
  validFrom     DateTime?    @db.Date
  validTo       DateTime?    @db.Date
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([legalEntityId, type, value])
  @@map("tax_registrations")
}

// A line of business (live production, broadcast, rentals…). Group-wide:
// one business unit can trade through several legal entities.
model BusinessUnit {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  costCentres   CostCentre[]
  opportunities Opportunity[]
  projects      Project[]

  @@map("business_units")
}

// A department or team. Group-wide and optionally nested.
model Department {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  parentId  String?      @db.Uuid
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")
  status    RecordStatus @default(ACTIVE)
  isDemo    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  costCentres CostCentre[]

  @@map("departments")
}

// Where costs are collected. Always owned by one legal entity.
model CostCentre {
  id             String        @id @default(uuid()) @db.Uuid
  legalEntityId  String        @db.Uuid
  legalEntity    LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  code           String
  name           String
  businessUnitId String?       @db.Uuid
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  departmentId   String?       @db.Uuid
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  status         RecordStatus  @default(ACTIVE)
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([legalEntityId, code])
  @@map("cost_centres")
}

enum LocationType {
  OFFICE
  WAREHOUSE
  STUDIO
  VENUE
  OTHER
}

// An office, warehouse or equipment store, studio or regular venue.
model Location {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  name          String
  type          LocationType
  legalEntityId String?      @db.Uuid
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?
  countryCode   String       @db.Char(2)
  timezone      String
  status        RecordStatus @default(ACTIVE)
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  equipmentAssets      EquipmentAsset[]
  equipmentStock       EquipmentStock[]
  equipmentMovements   EquipmentStockMovement[]
  equipmentMaintenance EquipmentMaintenance[]

  equipmentBookingMovements EquipmentBookingMovement[]
  purchaseOrders            PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]

  @@map("locations")
}

// ─── Audit log ────────────────────────────────────────────────────────────────
// Append-only. A database trigger (see the audit_log migration) rejects UPDATE
// and DELETE, so history can't be edited through the application.

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  occurredAt    DateTime       @default(now()) @db.Timestamptz(3)
  actorType     AuditActorType
  // No foreign key: the log must outlive any change to the users table.
  actorId       String?        @db.Uuid
  // Name and email at the time of the action.
  actorLabel    String
  // Dotted verb, e.g. "user.role_granted", "legal_entity.updated".
  action        String
  targetType    String
  targetId      String?
  // Set when the event concerns one legal entity; controls who can see it.
  legalEntityId String?        @db.Uuid
  // Field-level before/after values: { field: { from, to } }.
  changes       Json?
  // Reason, IP address, user agent and other context.
  metadata      Json?

  @@index([targetType, targetId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([legalEntityId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

// ─── Numbering schemes ────────────────────────────────────────────────────────
// Human-readable document numbers (Q-2026-0001). Internal ids stay UUIDs.

enum NumberResetPolicy {
  NEVER
  YEARLY // calendar year in the entity's time zone
  FISCAL_YEARLY // fiscal year starting in fiscalYearStartMonth
  MONTHLY
}

model NumberingScheme {
  id                   String            @id @default(uuid()) @db.Uuid
  // A key from src/server/numbering/document-types.ts, e.g. "quotation".
  documentType         String
  // Every series belongs to one legal entity: invoice series must not be shared
  // across entities (each GSTIN keeps its own consecutive series).
  legalEntityId        String            @db.Uuid
  legalEntity          LegalEntity       @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  // Tokens: {ENTITY} {YYYY} {YY} {MM} {FY} {FYY} {SEQ:n}. See docs/numbering.md.
  pattern              String
  resetPolicy          NumberResetPolicy
  // 1 = January. India's fiscal year starts in April.
  fiscalYearStartMonth Int               @default(4)
  // First number issued in each period. Lets a migrated series continue.
  startAt              Int               @default(1)
  status               RecordStatus      @default(ACTIVE)
  isDemo               Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  counters NumberCounter[]

  // At most one active scheme per document type per entity.
  @@unique([documentType, legalEntityId], map: "numbering_schemes_active_key", where: raw("status = 'ACTIVE'"))
  @@index([legalEntityId])
  @@map("numbering_schemes")
}

// The last number issued for one scheme in one period.
model NumberCounter {
  schemeId  String          @db.Uuid
  scheme    NumberingScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  // "all", "2026", "FY2026" or "2026-10", depending on the reset policy.
  periodKey String
  lastValue Int
  updatedAt DateTime        @updatedAt

  @@id([schemeId, periodKey])
  @@map("number_counters")
}

// ─── Master data: tax rates, payment terms, units ─────────────────────────────
// Group-wide configuration. Documents copy the values they use (rate, label,
// instalments) so later changes never rewrite an issued quote or invoice.

enum TaxTreatment {
  STANDARD // a positive rate, e.g. GST 18%
  ZERO_RATED // taxable at 0%, e.g. exports of services
  EXEMPT
  OUT_OF_SCOPE
}

// A tax rate for one country. Rates are basis points (1800 = 18%) and never
// change once created: archive and replace instead.
model TaxRate {
  id          String       @id @default(uuid()) @db.Uuid
  countryCode String       @db.Char(2)
  code        String
  name        String
  rateBps     Int
  treatment   TaxTreatment @default(STANDARD)
  // The rate new lines get for entities in this country. One per country.
  isDefault   Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([countryCode, code])
  @@unique([countryCode], map: "tax_rates_one_default_per_country_key", where: raw("\"isDefault\" AND status = 'ACTIVE'"))
  @@map("tax_rates")
}

enum PaymentTrigger {
  ON_ACCEPTANCE // advance, due when the client accepts
  BEFORE_START // `days` before the project or event starts
  ON_DELIVERY // when the work is delivered
  AFTER_DELIVERY // `days` after delivery
}

// A named payment schedule, e.g. "50% advance, balance on delivery".
model PaymentTerm {
  id          String                  @id @default(uuid()) @db.Uuid
  code        String                  @unique
  name        String
  description String?
  // Used for new quotes. At most one active default.
  isDefault   Boolean                 @default(false)
  status      RecordStatus            @default(ACTIVE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  instalments PaymentTermInstalment[]

  @@unique([isDefault], map: "payment_terms_one_default_key", where: raw("\"isDefault\" AND status = 'ACTIVE'"))
  @@map("payment_terms")
}

// One instalment of a payment term. Percentages of a term add up to 100%.
model PaymentTermInstalment {
  id            String         @id @default(uuid()) @db.Uuid
  paymentTermId String         @db.Uuid
  paymentTerm   PaymentTerm    @relation(fields: [paymentTermId], references: [id], onDelete: Cascade)
  position      Int
  label         String
  percentBps    Int
  trigger       PaymentTrigger
  days          Int            @default(0)

  @@unique([paymentTermId, position])
  @@map("payment_term_instalments")
}

// A unit of measure for quantities: each, day, hour, set, show…
model Unit {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("units")
}

// ─── CRM: clients and contacts ────────────────────────────────────────────────
// Clients are shared across the group: one client can work with several HMBL
// entities. Anything commercial or financial about them (opportunities,
// quotes, invoices) belongs to one legal entity.

enum ClientKind {
  COMPANY
  INDIVIDUAL
}

enum ClientRelationship {
  PROSPECT // no accepted work yet
  CLIENT
}

model Client {
  id             String             @id @default(uuid()) @db.Uuid
  name           String
  // Lower-case name without punctuation or company suffixes, for duplicate checks.
  normalizedName String
  legalName      String?
  kind           ClientKind         @default(COMPANY)
  relationship   ClientRelationship @default(PROSPECT)
  industry       String?
  website        String?
  email          String?
  phone          String?
  // GSTIN, VAT, TRN… Free text so new jurisdictions need no code.
  taxIdType      String?
  taxId          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  // State or province; for India the GST state, which decides place of supply.
  region         String?
  postalCode     String?
  countryCode    String             @db.Char(2)
  // Currency quotes for this client start in.
  currency       String             @db.Char(3)
  // Short code in invoice numbers ({CLIENT}), e.g. MAG. Null for one-off
  // clients, who share the code INT.
  invoiceCode    String?
  ownerId        String?            @db.Uuid
  owner          User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  notes          String?
  status         RecordStatus       @default(ACTIVE)
  // Set when this record was merged into another; it is then archived.
  mergedIntoId   String?            @db.Uuid
  mergedInto     Client?            @relation("ClientMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom     Client[]           @relation("ClientMerge")
  isDemo         Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  activities    CrmActivity[]
  quotes        Quote[]
  projects      Project[]
  salesInvoices SalesInvoice[]
  receipts      Receipt[]

  portalInvitations PortalInvitation[]
  portalAccounts    PortalAccount[]

  portalShares PortalShare[]

  @@unique([taxIdType, taxId], map: "clients_tax_id_key", where: raw("\"taxId\" IS NOT NULL AND status = 'ACTIVE'"))
  @@unique([invoiceCode], map: "clients_invoice_code_key", where: raw("\"invoiceCode\" IS NOT NULL AND status = 'ACTIVE'"))
  @@index([normalizedName])
  @@index([status, name])
  @@map("clients")
}

// A person at a client. At most one active primary contact per client.
model Contact {
  id        String       @id @default(uuid()) @db.Uuid
  clientId  String       @db.Uuid
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name      String
  jobTitle  String?
  email     String?
  phone     String?
  isPrimary Boolean      @default(false)
  notes     String?
  status    RecordStatus @default(ACTIVE)
  isDemo    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  opportunities Opportunity[]
  quoteVersions QuoteVersion[]

  portalInvitations PortalInvitation[]
  portalAccounts    PortalAccount[]

  @@unique([clientId], map: "contacts_one_primary_key", where: raw("\"isPrimary\" AND status = 'ACTIVE'"))
  @@index([clientId])
  @@map("contacts")
}

// ─── CRM: pipeline ────────────────────────────────────────────────────────────

enum StageKind {
  OPEN
  WON
  LOST
  ON_HOLD // deferred
  CANCELLED
}

// A configurable pipeline stage. Defaults follow the spec:
// New → Qualified → Discovery → Estimation → Proposal sent → Negotiation → Won / Lost / On hold.
model PipelineStage {
  id             String       @id @default(uuid()) @db.Uuid
  key            String       @unique
  name           String
  kind           StageKind
  position       Int
  // Default win probability for opportunities in this stage.
  probabilityBps Int?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  opportunities Opportunity[]

  @@map("pipeline_stages")
}

// Commercial work HMBL is pursuing, from first enquiry to won or lost.
// Belongs to the legal entity that would contract the work.
model Opportunity {
  id                 String        @id @default(uuid()) @db.Uuid
  legalEntityId      String        @db.Uuid
  legalEntity        LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  clientId           String        @db.Uuid
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactId          String?       @db.Uuid
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  stageId            String        @db.Uuid
  stage              PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  ownerId            String?       @db.Uuid
  owner              User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Business line.
  businessUnitId     String?       @db.Uuid
  businessUnit       BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  // Where the enquiry came from: referral, website, repeat client…
  source             String?
  // Opportunity value: the salesperson's estimate. Not a quoted or contract value.
  expectedValueMinor BigInt?
  currency           String        @db.Char(3)
  // Overrides the stage's default probability when set.
  probabilityBps     Int?
  expectedCloseDate  DateTime?     @db.Date
  eventStartDate     DateTime?     @db.Date
  eventEndDate       DateTime?     @db.Date
  venue              String?
  competitors        String?
  // Why it was won, lost, put on hold or cancelled.
  outcomeReason      String?
  closedAt           DateTime?
  isDemo             Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  stageChanges OpportunityStageChange[]
  activities   CrmActivity[]
  quotes       Quote[]
  projects     Project[]

  @@index([legalEntityId, stageId])
  @@index([clientId])
  @@map("opportunities")
}

// Every stage move, for the opportunity's history and pipeline reporting.
model OpportunityStageChange {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStageId   String?     @db.Uuid
  toStageId     String      @db.Uuid
  reason        String?
  actorId       String?     @db.Uuid
  actorLabel    String
  changedAt     DateTime    @default(now())

  @@index([opportunityId, changedAt])
  @@map("opportunity_stage_changes")
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  FOLLOW_UP
}

// A note, call, meeting or follow-up with a client, optionally about one opportunity.
model CrmActivity {
  id            String       @id @default(uuid()) @db.Uuid
  clientId      String       @db.Uuid
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  opportunityId String?      @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  type          ActivityType
  subject       String
  body          String?
  occurredAt    DateTime
  // Follow-ups: when it's due and when it was done.
  dueAt         DateTime?
  completedAt   DateTime?
  ownerId       String?      @db.Uuid
  owner         User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdById   String       @db.Uuid
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([clientId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([ownerId, dueAt])
  @@map("crm_activities")
}

// ─── Estimates and quotations ────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  ACCEPTED
  DECLINED
  SUPERSEDED
  WITHDRAWN
}

enum PricingMethod {
  UNIT_RATE
  FIXED
  COST_PLUS_MARKUP
  COST_PLUS_MARGIN
}

enum LineCategory {
  CREW
  EQUIPMENT
  RENTAL
  SERVICES
  PRODUCTION
  TRAVEL
  LOGISTICS
  FEES
  OTHER
}

// A quotation: one number, one or more versions. Only the latest version is
// worked on; earlier ones are kept as revision history.
model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  legalEntityId  String       @db.Uuid
  legalEntity    LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  number         String
  clientId       String       @db.Uuid
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  opportunityId  String?      @db.Uuid
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  title          String
  ownerId        String?      @db.Uuid
  owner          User?        @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Version number of the latest version.
  currentVersion Int          @default(1)
  createdById    String       @db.Uuid
  createdBy      User         @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  versions QuoteVersion[]
  projects Project[]

  portalShares PortalShare[]

  @@unique([legalEntityId, number])
  @@index([clientId])
  @@index([opportunityId])
  @@map("quotes")
}

// Everything the client is offered. Editable only while DRAFT; the database
// refuses changes to a version (or its lines) once it has left draft.
model QuoteVersion {
  id                 String            @id @default(uuid()) @db.Uuid
  quoteId            String            @db.Uuid
  quote              Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  version            Int
  status             QuoteStatus       @default(DRAFT)
  contactId          String?           @db.Uuid
  contact            Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  currency           String            @db.Char(3)
  // Units of the entity's base currency per unit of `currency`; null when they match.
  fxRateToBase       Decimal?          @db.Decimal(18, 8)
  fxNote             String?
  validUntil         DateTime          @db.Date
  // Copied from the payment term when chosen, so later edits to the term don't
  // change a quote: [{ label, percentBps, trigger, days }].
  paymentTermId      String?           @db.Uuid
  paymentTermName    String?
  paymentSchedule    Json              @default("[]")
  // The default tax for new lines and the rate contingency is taxed at.
  taxRateId          String?           @db.Uuid
  taxRateBps         Int               @default(0)
  // A client-visible allowance, as a share of the subtotal.
  contingencyBps     Int               @default(0)
  poRequired         Boolean           @default(false)
  eventStartDate     DateTime?         @db.Date
  eventEndDate       DateTime?         @db.Date
  venue              String?
  scope              String?
  deliverables       String?
  exclusions         String?
  terms              String?
  // Never shown to the client.
  internalNotes      String?
  // Stored totals, recalculated on every save from the lines.
  subtotalMinor      BigInt            @default(0)
  discountMinor      BigInt            @default(0)
  contingencyMinor   BigInt            @default(0)
  taxMinor           BigInt            @default(0)
  totalMinor         BigInt            @default(0)
  costMinor          BigInt            @default(0)
  marginBps          Int?
  createdById        String            @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // Workflow: who moved it and when. The only fields that change after draft.
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedById       String?           @db.Uuid
  issuedAt           DateTime?
  issuedById         String?           @db.Uuid
  withdrawnAt        DateTime?
  // Why it was withdrawn, declined or superseded.
  statusReason       String?
  // The client's answer, recorded on an issued version.
  declinedAt         DateTime?
  acceptedOn         DateTime?         @db.Date
  acceptedByName     String?
  acceptanceMethod   AcceptanceMethod?
  clientPoNumber     String?
  acceptanceNotes    String?
  // Who recorded the answer (accepted or declined), and when.
  answerRecordedAt   DateTime?
  answerRecordedById String?           @db.Uuid

  lines   QuoteLine[]
  steps   QuoteApprovalStep[]
  project Project?

  portalResponse QuotePortalResponse?

  @@unique([quoteId, version])
  @@index([status])
  @@map("quote_versions")
}

model QuoteLine {
  id             String        @id @default(uuid()) @db.Uuid
  versionId      String        @db.Uuid
  version        QuoteVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  position       Int
  // Optional heading lines are grouped under, e.g. "Stage and AV".
  section        String?
  category       LineCategory  @default(OTHER)
  description    String
  method         PricingMethod @default(UNIT_RATE)
  quantity       Decimal       @db.Decimal(12, 3)
  days           Decimal       @db.Decimal(12, 3)
  unitId         String?       @db.Uuid
  unitCode       String?
  unitCostMinor  BigInt        @default(0)
  unitPriceMinor BigInt        @default(0)
  markupBps      Int?
  marginBps      Int?
  discountBps    Int           @default(0)
  taxRateId      String?       @db.Uuid
  taxCode        String?
  taxRateBps     Int           @default(0)
  costMinor      BigInt
  grossMinor     BigInt
  discountMinor  BigInt
  netMinor       BigInt
  taxMinor       BigInt
  totalMinor     BigInt

  @@unique([versionId, position])
  @@map("quote_lines")
}

// Per-entity rules for quotes. A missing row means the defaults below.
model CommercialSettings {
  legalEntityId          String      @id @db.Uuid
  legalEntity            LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  // Off by default (decided 2026-10-23): when on, quotes need the Director's
  // approval before they can be issued.
  requireQuoteApproval   Boolean     @default(false)
  // Quotes whose total (in the entity's base currency) is below this skip
  // approval. Null: every quote needs it.
  approvalThresholdMinor BigInt?
  quoteValidityDays      Int         @default(30)
  updatedAt              DateTime    @updatedAt

  @@map("commercial_settings")
}

enum QuoteApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
}

// The approval trail of a quote version, with the figures the approver saw.
model QuoteApprovalStep {
  id           String              @id @default(uuid()) @db.Uuid
  versionId    String              @db.Uuid
  version      QuoteVersion        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  action       QuoteApprovalAction
  actorId      String?             @db.Uuid
  actor        User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel   String
  comment      String?
  // Approved by the same person who submitted it.
  selfApproval Boolean             @default(false)
  totalMinor   BigInt
  marginBps    Int?
  at           DateTime            @default(now())

  @@index([versionId, at])
  @@map("quote_approval_steps")
}

// How the client said yes.
enum AcceptanceMethod {
  SIGNED_QUOTE
  EMAIL
  PURCHASE_ORDER
  OTHER
  // Accepted by the client in the portal (quote_portal_responses has the evidence).
  PORTAL
}

// ─── Projects ────────────────────────────────────────────────────────────────

// The lifecycle (docs/projects.md). Moves are checked in src/server/projects/lifecycle.ts.
enum ProjectStatus {
  DRAFT
  COMMERCIAL_REVIEW
  APPROVED
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  FINANCIAL_CLOSE
  CLOSED
  ON_HOLD
  CANCELLED
}

enum RevenueModel {
  FIXED_FEE
  ITEMISED
  DAY_RATE
  RENTAL
  RETAINER
  COST_PLUS
  INTERNAL
}

/// Configurable kinds of engagement (spec §2): live event, broadcast, rental, touring…
model ProjectType {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique
  name                String
  description         String?
  defaultRevenueModel RevenueModel @default(ITEMISED)
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  projects Project[]

  @@map("project_types")
}

// A job HMBL is delivering. Created from an accepted quote version, whose
// commercial terms it keeps as its baseline.
model Project {
  id                   String         @id @default(uuid()) @db.Uuid
  legalEntityId        String         @db.Uuid
  legalEntity          LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  number               String
  name                 String
  status               ProjectStatus  @default(DRAFT)
  // Where a project on hold or cancelled goes back to when resumed or reopened.
  resumeStatus         ProjectStatus?
  statusChangedAt      DateTime       @default(now())
  projectTypeId        String?        @db.Uuid
  projectType          ProjectType?   @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)
  revenueModel         RevenueModel   @default(ITEMISED)
  businessUnitId       String?        @db.Uuid
  businessUnit         BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  projectManagerId     String?        @db.Uuid
  projectManager       User?          @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  producerId           String?        @db.Uuid
  producer             User?          @relation("ProjectProducer", fields: [producerId], references: [id], onDelete: SetNull)
  // Internal projects have no client.
  clientId             String?        @db.Uuid
  client               Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  opportunityId        String?        @db.Uuid
  opportunity          Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  // Set when the project came from an accepted quote; null for projects
  // created directly (internal work, retainers).
  quoteId              String?        @db.Uuid
  quote                Quote?         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  // One project per accepted version.
  sourceQuoteVersionId String?        @unique @db.Uuid
  sourceQuoteVersion   QuoteVersion?  @relation(fields: [sourceQuoteVersionId], references: [id], onDelete: Restrict)
  currency             String         @db.Char(3)
  fxRateToBase         Decimal?       @db.Decimal(18, 8)
  // Baseline from the quote: value before tax (lines and contingency), tax,
  // total, and the budgeted cost.
  contractValueMinor   BigInt         @default(0)
  taxMinor             BigInt         @default(0)
  totalMinor           BigInt         @default(0)
  budgetCostMinor      BigInt         @default(0)
  clientPoNumber       String?
  eventStartDate       DateTime?      @db.Date
  eventEndDate         DateTime?      @db.Date
  venue                String?
  // Other cities or sites, one per line, for tours and multi-site work.
  locations            String?
  description          String?
  scope                String?
  deliverables         String?
  // When the original budget was fixed: on approval, or on creation from a quote.
  baselineLockedAt     DateTime?
  createdById          String         @db.Uuid
  createdBy            User           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  isDemo               Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  budgetLines       ProjectBudgetLine[]
  milestones        ProjectMilestone[]
  statusChanges     ProjectStatusChange[]
  costEntries       ProjectCostEntry[]
  changeOrders      ProjectChangeOrder[]
  budgetVersions    ProjectBudgetVersion[]
  scheduleItems     ProjectScheduleItem[]
  resources         ProjectResourceRequirement[]
  documents         RecordDocument[]
  purchaseOrders    PurchaseOrder[]
  closeoutItems     ProjectCloseoutItem[]
  crewAssignments   CrewAssignment[]
  journalLines      JournalLine[]
  salesInvoices     SalesInvoice[]
  billLines         VendorBillLine[]
  staffAdvances     StaffAdvance[]
  expenseClaimLines ExpenseClaimLine[]

  equipmentBookings EquipmentBooking[]
  travelRequests    TravelRequest[]
  shipments         Shipment[]

  portalShares      PortalShare[]
  portalSubmissions PortalSubmission[]

  @@unique([legalEntityId, number])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

/// Every lifecycle move, including the project's creation (fromStatus null).
model ProjectStatusChange {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @db.Uuid
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus ProjectStatus?
  toStatus   ProjectStatus
  reason     String?
  // A move that went ahead although a rule would have stopped it.
  override   Boolean        @default(false)
  actorId    String?        @db.Uuid
  actorLabel String
  at         DateTime       @default(now())

  @@index([projectId, at])
  @@map("project_status_changes")
}

// The cost and revenue plan, one line per quote line.
model ProjectBudgetLine {
  id                String       @id @default(uuid()) @db.Uuid
  projectId         String       @db.Uuid
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position          Int
  section           String?
  category          LineCategory
  costCodeId        String?      @db.Uuid
  costCode          CostCode?    @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  description       String
  quantity          Decimal      @db.Decimal(12, 3)
  days              Decimal      @db.Decimal(12, 3)
  unitCode          String?
  // The original approved budget. Frozen once the project's baseline is
  // locked (a database trigger enforces it); changes go through change orders.
  costMinor         BigInt
  // Selling amount after discount, before tax.
  revenueMinor      BigInt
  // The project manager's estimate of the final cost, when it differs from
  // the calculated forecast. Null uses the calculation (docs/budget.md).
  forecastCostMinor BigInt?
  forecastNote      String?

  costEntries ProjectCostEntry[]
  resources   ProjectResourceRequirement[]
  changeLines ProjectChangeOrderLine[]
  orderLines  PurchaseOrderLine[]

  @@unique([projectId, position])
  @@map("project_budget_lines")
}

/// Configurable cost codes under the budget categories (the quote line categories).
model CostCode {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  category    LineCategory
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  budgetLines ProjectBudgetLine[]

  @@map("cost_codes")
}

enum CostEntryKind {
  // A purchase or booking HMBL has agreed to pay for but not yet been billed.
  COMMITMENT
  // A cost incurred: a bill, an expense, a settlement.
  ACTUAL
}

/// Committed and actual costs against a budget line. Entries are never edited
/// or deleted: a mistake is voided with a reason and entered again.
model ProjectCostEntry {
  id           String             @id @default(uuid()) @db.Uuid
  projectId    String             @db.Uuid
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLineId String             @db.Uuid
  budgetLine   ProjectBudgetLine  @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  kind         CostEntryKind
  // In the project's currency; always positive.
  amountMinor  BigInt
  entryDate    DateTime           @db.Date
  description  String
  supplier     String?
  reference    String?
  // An actual cost that draws down a commitment, so it isn't counted twice.
  commitmentId String?            @db.Uuid
  commitment   ProjectCostEntry?  @relation("CommitmentDrawdown", fields: [commitmentId], references: [id], onDelete: Restrict)
  drawdowns    ProjectCostEntry[] @relation("CommitmentDrawdown")
  // The finance document that posted this entry (a vendor bill line, an
  // expense); such entries are voided through that document.
  sourceType   String?
  sourceId     String?            @db.Uuid
  // A commitment with nothing more to come: what wasn't billed is released.
  closedAt     DateTime?
  voidedAt     DateTime?
  voidReason   String?
  createdById  String             @db.Uuid
  createdBy    User               @relation("ProjectCostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())

  @@index([projectId])
  @@index([budgetLineId])
  @@map("project_cost_entries")
}

// A billing milestone from the quote's payment schedule.
model ProjectMilestone {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @db.Uuid
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position      Int
  label         String
  percentBps    Int
  trigger       PaymentTrigger
  days          Int            @default(0)
  // Share of the quote total, including tax. Milestones add up to the total.
  amountMinor   BigInt
  // Known when the trigger's date is: acceptance, or the event dates.
  dueDate       DateTime?      @db.Date
  // Set by hand: kept when the event dates move. The note says why.
  dueDateManual Boolean        @default(false)
  dueDateNote   String?

  invoices SalesInvoice[]

  @@unique([projectId, position])
  @@map("project_milestones")
}

enum ChangeOrderStatus {
  DRAFT
  APPROVED
  WITHDRAWN
}

/// A controlled change to an approved project's budget, scope or schedule
/// (spec §10, "Change control"). Approved change orders are the only way the
/// revised budget moves away from the original.
model ProjectChangeOrder {
  id                      String            @id @default(uuid()) @db.Uuid
  projectId               String            @db.Uuid
  project                 Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // CO-01, CO-02… within the project.
  number                  Int
  title                   String
  reason                  String
  description             String?
  scopeImpact             String?
  scheduleImpact          String?
  // Positive delays the end date, negative brings it forward.
  scheduleImpactDays      Int?
  status                  ChangeOrderStatus @default(DRAFT)
  // Totals of the lines, kept in step on every save.
  costDeltaMinor          BigInt            @default(0)
  revenueDeltaMinor       BigInt            @default(0)
  // The client's agreement, required when the change alters revenue.
  clientApprovedOn        DateTime?         @db.Date
  clientApprovedByName    String?
  clientApprovalMethod    AcceptanceMethod?
  clientApprovalReference String?
  // Why it was withdrawn, or a comment on approval.
  statusComment           String?
  decidedAt               DateTime?
  decidedById             String?           @db.Uuid
  createdById             String            @db.Uuid
  createdBy               User              @relation("ChangeOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  lines         ProjectChangeOrderLine[]
  budgetVersion ProjectBudgetVersion?

  @@unique([projectId, number])
  @@index([status])
  @@map("project_change_orders")
}

/// One budget movement in a change order: an existing line up or down, or a new line.
model ProjectChangeOrderLine {
  id                String             @id @default(uuid()) @db.Uuid
  changeOrderId     String             @db.Uuid
  changeOrder       ProjectChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  position          Int
  // The line it changes. For a new line it is null until approval creates it.
  budgetLineId      String?            @db.Uuid
  budgetLine        ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  // For a new line.
  newCategory       LineCategory?
  newDescription    String?
  newCostCodeId     String?            @db.Uuid
  costDeltaMinor    BigInt
  revenueDeltaMinor BigInt
  note              String?

  @@unique([changeOrderId, position])
  @@index([budgetLineId])
  @@map("project_change_order_lines")
}

/// The budget's history: version 1 is the original, each approved change order adds one.
model ProjectBudgetVersion {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int
  changeOrderId  String?             @unique @db.Uuid
  changeOrder    ProjectChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: Restrict)
  // The revised budget cost and expected revenue (before tax) after this version.
  costMinor      BigInt
  revenueMinor   BigInt
  createdById    String?             @db.Uuid
  createdByLabel String
  createdAt      DateTime            @default(now())

  @@unique([projectId, version])
  @@map("project_budget_versions")
}

enum ScheduleItemKind {
  SHOW
  PHASE
  MILESTONE
}

/// The project's plan in dates: show dates, phases such as build or load-in,
/// and delivery milestones that are ticked off when done.
model ProjectScheduleItem {
  id            String           @id @default(uuid()) @db.Uuid
  projectId     String           @db.Uuid
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          ScheduleItemKind
  title         String
  startDate     DateTime         @db.Date
  // Shows and phases can span days; milestones are a single date.
  endDate       DateTime?        @db.Date
  location      String?
  notes         String?
  completedAt   DateTime?
  completedById String?          @db.Uuid
  completedBy   User?            @relation("ScheduleItemCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdById   String           @db.Uuid
  createdBy     User             @relation("ScheduleItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, startDate])
  @@map("project_schedule_items")
}

enum ResourceKind {
  CREW
  EQUIPMENT
}

/// What a project needs: a crew role or an equipment item, how many, for
/// which days, and the budget line that pays for it. Named people and
/// specific assets are assigned later (Stage 5).
model ProjectResourceRequirement {
  id           String             @id @default(uuid()) @db.Uuid
  projectId    String             @db.Uuid
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         ResourceKind
  // The crew role or the equipment item, e.g. "Lighting operator", "LED wall 4×3 m".
  name         String
  quantity     Int
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  budgetLineId String?            @db.Uuid
  budgetLine   ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  // Planned cost per unit per day, before tax, in the project's currency.
  dayRateMinor BigInt?
  notes        String?
  createdById  String             @db.Uuid
  createdBy    User               @relation("ResourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  crewAssignments CrewAssignment[]

  equipmentBookings EquipmentBooking[]

  @@index([projectId, kind])
  @@map("project_resource_requirements")
}

enum DocumentCategory {
  CONTRACT
  CLIENT_PO
  TECHNICAL
  CALL_SHEET
  TRAVEL
  DELIVERABLE
  CLOSEOUT_REPORT
  OTHER
  QUOTATION
  SIGNED_AGREEMENT
  VENDOR_PO
  INVOICE
  RECEIPT
  EXPENSE_EVIDENCE
  EQUIPMENT_CHECKLIST
  COMPLIANCE
  IDENTITY
}

/// The kind of record a document belongs to (docs/documents.md).
enum DocumentRecordType {
  PROJECT
  CLIENT
  QUOTE
  VENDOR
  PURCHASE_ORDER
  VENDOR_BILL
  SALES_INVOICE
  CREW_MEMBER
  EQUIPMENT_ITEM
  TRAVEL_REQUEST
  SHIPMENT
}

/// RESTRICTED documents also need documents.view_sensitive to see or download.
enum DocumentAccess {
  STANDARD
  RESTRICTED
}

/// A file attached to a business record (`recordType`, `recordId`). The bytes
/// live on disk under STORAGE_DIR (`storageKey`); a new version is a new row
/// and a new file, so files are never overwritten. Documents are archived,
/// never deleted. `legalEntityId` is the record's entity, or null for records
/// shared across entities (clients, vendors, crew, equipment).
model RecordDocument {
  id                String             @id @default(uuid()) @db.Uuid
  recordType        DocumentRecordType
  recordId          String             @db.Uuid
  legalEntityId     String?            @db.Uuid
  legalEntity       LegalEntity?       @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  // Set for project documents and for records that belong to a project.
  projectId         String?            @db.Uuid
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  category          DocumentCategory
  access            DocumentAccess     @default(STANDARD)
  title             String
  fileName          String
  contentType       String
  sizeBytes         BigInt
  sha256            String             @db.Char(64)
  storageKey        String             @unique
  version           Int                @default(1)
  // The version this one replaces; that one gets `supersededAt`.
  previousVersionId String?            @unique @db.Uuid
  previousVersion   RecordDocument?    @relation("DocumentVersions", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion       RecordDocument?    @relation("DocumentVersions")
  // Kept at least until this date; set from the category when uploaded.
  retainUntil       DateTime?          @db.Date
  supersededAt      DateTime?
  archivedAt        DateTime?
  archiveReason     String?
  uploadedById      String             @db.Uuid
  uploadedBy        User               @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt        DateTime           @default(now())

  portalShares PortalShare[]

  @@index([recordType, recordId])
  @@index([projectId, category])
  @@index([legalEntityId, uploadedAt])
  @@map("documents")
}

enum CloseoutItemKey {
  INVOICES_ISSUED
  PAYMENTS_COLLECTED
  VENDOR_BILLS_RECEIVED
  CREW_SETTLED
  EQUIPMENT_RETURNED
  EXPENSES_RECONCILED
  FINAL_REPORT
}

/// One closeout requirement, ticked off (or marked not applicable) before
/// the project closes. A missing row means not done yet.
model ProjectCloseoutItem {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            CloseoutItemKey
  doneAt         DateTime?
  notApplicable  Boolean         @default(false)
  note           String?
  updatedById    String?         @db.Uuid
  updatedByLabel String
  updatedAt      DateTime        @updatedAt

  @@unique([projectId, key])
  @@map("project_closeout_items")
}

// ─── Finance: ledger ─────────────────────────────────────────────────────────
// Double-entry books, one set per legal entity (docs/ledger.md). Every
// financial document posts a journal through src/server/finance/ledger.ts;
// nothing keeps a balance field. Posted journals never change: corrections
// are reversals.

enum RevenueRecognition {
  ON_INVOICE // revenue when the invoice is issued (default)
  ON_COMPLETION // invoiced amounts wait as client advances until the project completes
}

/// Per-entity finance rules. A missing row means the defaults below.
model FinanceSettings {
  legalEntityId        String             @id @db.Uuid
  legalEntity          LegalEntity        @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  // 1 = January. India's financial year starts in April.
  fiscalYearStartMonth Int                @default(4)
  revenueRecognition   RevenueRecognition @default(ON_INVOICE)
  updatedAt            DateTime           @updatedAt

  @@map("finance_settings")
}

/// What an entity sells, as coded in its invoice numbers ({SERVICE}), e.g.
/// VLR for rentals. The code never changes once created; archive it instead.
model InvoiceService {
  id            String       @id @default(uuid()) @db.Uuid
  legalEntityId String       @db.Uuid
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  code          String
  name          String
  status        RecordStatus @default(ACTIVE)
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([legalEntityId, code])
  @@map("invoice_services")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Where an account appears in the financial statements. Each belongs to one AccountType.
enum AccountSubtype {
  CASH
  BANK
  RECEIVABLE
  CURRENT_ASSET
  FIXED_ASSET
  PAYABLE
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  REVENUE
  OTHER_INCOME
  DIRECT_COST
  OPERATING_EXPENSE
}

/// One account in an entity's chart of accounts. Amounts are always in the
/// entity's base currency.
model LedgerAccount {
  id            String         @id @default(uuid()) @db.Uuid
  legalEntityId String         @db.Uuid
  legalEntity   LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  code          String
  name          String
  type          AccountType
  subtype       AccountSubtype
  description   String?
  // The role this account plays in automatic postings (receivables, output
  // CGST…), from src/server/finance/accounts-default.ts. One per entity.
  systemKey     String?
  // Control accounts (receivables, payables, advances) are posted only by
  // their documents, so they always agree with the open items behind them.
  isControl     Boolean        @default(false)
  status        RecordStatus   @default(ACTIVE)
  isDemo        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lines              JournalLine[]
  bankAccount        BankAccount?
  receipts           Receipt[]
  vendorPayments     VendorPayment[]
  billLines          VendorBillLine[]
  staffAdvances      StaffAdvance[]
  advanceReturns     AdvanceReturn[]
  expenseClaimLines  ExpenseClaimLine[]
  expenseSettlements ExpenseSettlement[]

  @@unique([legalEntityId, code])
  @@unique([legalEntityId, systemKey])
  @@index([legalEntityId, type])
  @@map("ledger_accounts")
}

enum PeriodStatus {
  OPEN
  CLOSED
}

/// A month of an entity's books. Nothing posts into a closed period.
model AccountingPeriod {
  id            String       @id @default(uuid()) @db.Uuid
  legalEntityId String       @db.Uuid
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  // "2026-27" for an April–March year, "2026" for a calendar year.
  fiscalYear    String
  name          String
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  status        PeriodStatus @default(OPEN)
  closedAt      DateTime?
  closedById    String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  journals    Journal[]
  closeEvents PeriodCloseEvent[]

  @@unique([legalEntityId, startDate])
  @@index([legalEntityId, fiscalYear])
  @@map("accounting_periods")
}

enum PeriodCloseAction {
  CLOSED
  REOPENED
}

/// Each close and reopen of a period, with who did it, why, and the close
/// checklist as it stood: the audit evidence. Never changed or deleted.
model PeriodCloseEvent {
  id        String            @id @default(uuid()) @db.Uuid
  periodId  String            @db.Uuid
  period    AccountingPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  action    PeriodCloseAction
  actorId   String            @db.Uuid
  // Required to reopen; on a close, the note acknowledging open warnings.
  note      String?
  evidence  Json
  createdAt DateTime          @default(now())

  @@index([periodId, createdAt])
  @@map("period_close_events")
}

enum JournalStatus {
  DRAFT
  POSTED
  DISCARDED
}

/// What created a journal. Manual journals are typed in by Finance; the rest
/// come from documents and point back at them with `sourceId`.
enum JournalSource {
  MANUAL
  OPENING_BALANCE
  REVERSAL
  SALES_INVOICE
  CREDIT_NOTE
  RECEIPT
  VENDOR_BILL
  VENDOR_PAYMENT
  EXPENSE_CLAIM
  ADVANCE
  BANK
  PERIOD_CLOSE
}

model Journal {
  id             String            @id @default(uuid()) @db.Uuid
  legalEntityId  String            @db.Uuid
  legalEntity    LegalEntity       @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  // Given when the journal is posted; drafts have none.
  number         String?
  date           DateTime          @db.Date
  periodId       String?           @db.Uuid
  period         AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  status         JournalStatus     @default(DRAFT)
  source         JournalSource     @default(MANUAL)
  // The invoice, bill, receipt… this journal records.
  sourceId       String?           @db.Uuid
  // A human reference for the source, e.g. the invoice number.
  sourceRef      String?
  narration      String
  // The entity's base currency, copied so the journal reads on its own.
  currency       String            @db.Char(3)
  // Sum of the debits (equal to the credits once posted).
  totalMinor     BigInt            @default(0)
  // Makes posting safe to retry: one journal per key per entity.
  idempotencyKey String?
  reversalOfId   String?           @unique @db.Uuid
  reversalOf     Journal?          @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     Journal?          @relation("JournalReversal")
  postedAt       DateTime?
  postedById     String?           @db.Uuid
  createdById    String?           @db.Uuid
  createdBy      User?             @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdByLabel String
  isDemo         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines JournalLine[]

  @@unique([legalEntityId, number])
  @@unique([legalEntityId, idempotencyKey])
  @@index([legalEntityId, date])
  @@index([source, sourceId])
  @@map("journals")
}

/// One debit or credit. Exactly one of the two amounts is positive.
model JournalLine {
  id            String        @id @default(uuid()) @db.Uuid
  journalId     String        @db.Uuid
  journal       Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  position      Int
  accountId     String        @db.Uuid
  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // In the entity's base currency.
  debitMinor    BigInt        @default(0)
  creditMinor   BigInt        @default(0)
  description   String?
  // The original currency amount when the document was in another currency.
  txCurrency    String?       @db.Char(3)
  txAmountMinor BigInt?
  fxRate        Decimal?      @db.Decimal(18, 8)
  // Who the line concerns, for receivable and payable balances:
  // CLIENT, VENDOR or PERSON (an employee or freelancer), and their id.
  partyType     String?
  partyId       String?       @db.Uuid
  projectId     String?       @db.Uuid
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  bankMatch     BankMatch?

  @@unique([journalId, position])
  @@index([accountId])
  @@index([projectId])
  @@index([partyType, partyId])
  @@map("journal_lines")
}

// ─── Finance: sales invoices and credit notes ────────────────────────────────
// Tax invoices to clients (docs/invoicing.md). Issuing numbers the invoice and
// posts it to the ledger; from then on it never changes, and corrections are
// credit notes.

// Proforma and commercial invoices ask the client to pay; only a tax invoice
// is a GST invoice and posts to the ledger. All three share one number series.
enum InvoiceKind {
  PROFORMA
  COMMERCIAL
  TAX
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  // A draft thrown away before it was issued. Issued invoices are never cancelled.
  DISCARDED
}

enum SupplyType {
  INTRA_STATE
  INTER_STATE
  EXPORT
  NON_GST
}

model SalesInvoice {
  id                   String            @id @default(uuid()) @db.Uuid
  legalEntityId        String            @db.Uuid
  legalEntity          LegalEntity       @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  kind                 InvoiceKind       @default(TAX)
  // Given when the invoice is issued; drafts have none.
  number               String?
  status               InvoiceStatus     @default(DRAFT)
  // The proforma or commercial invoice this one was made from.
  sourceInvoiceId      String?           @db.Uuid
  sourceInvoice        SalesInvoice?     @relation("InvoiceSource", fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  madeFrom             SalesInvoice[]    @relation("InvoiceSource")
  clientId             String            @db.Uuid
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId            String?           @db.Uuid
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // The billing milestone this invoice bills, if any.
  milestoneId          String?           @db.Uuid
  milestone            ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  invoiceDate          DateTime          @db.Date
  dueDate              DateTime          @db.Date
  currency             String            @db.Char(3)
  // Units of the entity's base currency per unit of `currency`; null when they match.
  fxRate               Decimal?          @db.Decimal(18, 8)
  fxNote               String?
  supplyType           SupplyType
  // GST state code of the place of supply ("18" for Assam); null outside India.
  placeOfSupplyCode    String?
  placeOfSupplyCountry String            @db.Char(2)
  // Copied from the client and the entity when issued, so the invoice reads
  // the same however those records change later.
  clientName           String
  clientGstin          String?
  clientAddress        String?
  entityGstin          String?
  clientPoNumber       String?
  // What was sold ({SERVICE} in the number), e.g. VLR. A code from the
  // entity's invoice services, kept as text so the issued number reads the same.
  serviceCode          String?
  notes                String?
  // Totals in the invoice currency, recalculated from the lines on every save.
  subtotalMinor        BigInt            @default(0)
  cgstMinor            BigInt            @default(0)
  sgstMinor            BigInt            @default(0)
  igstMinor            BigInt            @default(0)
  otherTaxMinor        BigInt            @default(0)
  taxMinor             BigInt            @default(0)
  totalMinor           BigInt            @default(0)
  // What the client owes in the base currency, as posted to receivables.
  baseTotalMinor       BigInt            @default(0)
  // Revenue held as client advances until the project completes
  // (revenue recognition "on completion"), then moved to revenue.
  revenueDeferred      Boolean           @default(false)
  revenueRecognisedAt  DateTime?
  journalId            String?           @unique @db.Uuid
  recognitionJournalId String?           @unique @db.Uuid
  issuedAt             DateTime?
  issuedById           String?           @db.Uuid
  createdById          String            @db.Uuid
  isDemo               Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  lines       SalesInvoiceLine[]
  creditNotes CreditNote[]
  allocations ReceiptAllocation[]

  @@unique([legalEntityId, number])
  // A proforma or commercial invoice becomes at most one invoice of each later kind.
  @@unique([sourceInvoiceId, kind], map: "sales_invoices_source_kind_key", where: raw("status <> 'DISCARDED'"))
  @@index([clientId])
  @@index([projectId])
  @@index([legalEntityId, status, dueDate])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id               String           @id @default(uuid()) @db.Uuid
  invoiceId        String           @db.Uuid
  invoice          SalesInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position         Int
  description      String
  // Services Accounting Code (or HSN for goods).
  sacCode          String?
  quantity         Decimal          @db.Decimal(12, 3)
  unitPriceMinor   BigInt
  // Taxable value: quantity × unit price, rounded.
  amountMinor      BigInt
  taxRateId        String?          @db.Uuid
  taxCode          String?
  taxRateBps       Int              @default(0)
  cgstMinor        BigInt           @default(0)
  sgstMinor        BigInt           @default(0)
  igstMinor        BigInt           @default(0)
  otherTaxMinor    BigInt           @default(0)
  taxMinor         BigInt           @default(0)
  totalMinor       BigInt
  revenueAccountId String           @db.Uuid
  creditLines      CreditNoteLine[]

  @@unique([invoiceId, position])
  @@map("sales_invoice_lines")
}

/// Reduces an issued invoice: a price correction, a cancelled service, a
/// goodwill discount. Always against one invoice, never more than it billed.
model CreditNote {
  id             String        @id @default(uuid()) @db.Uuid
  legalEntityId  String        @db.Uuid
  legalEntity    LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  number         String?
  status         InvoiceStatus @default(DRAFT)
  invoiceId      String        @db.Uuid
  invoice        SalesInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  date           DateTime      @db.Date
  reason         String
  subtotalMinor  BigInt        @default(0)
  cgstMinor      BigInt        @default(0)
  sgstMinor      BigInt        @default(0)
  igstMinor      BigInt        @default(0)
  otherTaxMinor  BigInt        @default(0)
  taxMinor       BigInt        @default(0)
  totalMinor     BigInt        @default(0)
  baseTotalMinor BigInt        @default(0)
  journalId      String?       @unique @db.Uuid
  issuedAt       DateTime?
  issuedById     String?       @db.Uuid
  createdById    String        @db.Uuid
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines CreditNoteLine[]

  @@unique([legalEntityId, number])
  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String           @id @default(uuid()) @db.Uuid
  creditNoteId  String           @db.Uuid
  creditNote    CreditNote       @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceLineId String           @db.Uuid
  invoiceLine   SalesInvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  position      Int
  // Taxable value credited, in the invoice currency.
  amountMinor   BigInt
  cgstMinor     BigInt           @default(0)
  sgstMinor     BigInt           @default(0)
  igstMinor     BigInt           @default(0)
  otherTaxMinor BigInt           @default(0)
  taxMinor      BigInt           @default(0)
  totalMinor    BigInt

  @@unique([creditNoteId, position])
  @@index([invoiceLineId])
  @@map("credit_note_lines")
}

/// A bank account of an entity, with its own ledger account (heading Bank).
/// Its details print on invoices so clients know where to pay.
model BankAccount {
  id                   String                @id @default(uuid()) @db.Uuid
  legalEntityId        String                @db.Uuid
  legalEntity          LegalEntity           @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  ledgerAccountId      String                @unique @db.Uuid
  ledgerAccount        LedgerAccount         @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  bankName             String
  branch               String?
  accountName          String
  accountNumber        String
  // IFSC for Indian accounts; SWIFT/BIC and IBAN for others.
  ifsc                 String?
  swift                String?
  iban                 String?
  currency             String                @db.Char(3)
  // Printed on invoices in this currency.
  showOnInvoices       Boolean               @default(false)
  status               RecordStatus          @default(ACTIVE)
  isDemo               Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  bankStatementImports BankStatementImport[]
  bankStatementLines   BankStatementLine[]
  bankMatches          BankMatch[]
  bankReconciliations  BankReconciliation[]

  @@index([legalEntityId])
  @@map("bank_accounts")
}

enum ReceiptStatus {
  POSTED
  VOIDED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  CARD
  OTHER
}

/// Money received from a client into a bank or cash account. Posted when
/// recorded; corrected by voiding, which reverses its journals.
model Receipt {
  id               String        @id @default(uuid()) @db.Uuid
  legalEntityId    String        @db.Uuid
  legalEntity      LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  number           String
  status           ReceiptStatus @default(POSTED)
  clientId         String        @db.Uuid
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // The bank or cash ledger account the money went into.
  depositAccountId String        @db.Uuid
  depositAccount   LedgerAccount @relation(fields: [depositAccountId], references: [id], onDelete: Restrict)
  date             DateTime      @db.Date
  method           PaymentMethod
  reference        String?
  currency         String        @db.Char(3)
  // Units of base currency per unit of `currency`; null when they match.
  fxRate           Decimal?      @db.Decimal(18, 8)
  // What arrived in the account.
  amountMinor      BigInt
  // Income tax the client deducted at source and paid to the government on
  // HMBL's behalf. Settles invoices like money received.
  tdsMinor         BigInt        @default(0)
  tdsSection       String?
  notes            String?
  // amount + TDS in the base currency, as posted.
  grossBaseMinor   BigInt
  journalId        String        @unique @db.Uuid
  // The accounting date of the void, when its journals were reversed.
  voidDate         DateTime?     @db.Date
  voidedAt         DateTime?
  voidedById       String?       @db.Uuid
  voidReason       String?
  createdById      String        @db.Uuid
  isDemo           Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  allocations ReceiptAllocation[]

  @@unique([legalEntityId, number])
  @@index([clientId])
  @@map("receipts")
}

/// Part of a receipt applied to an invoice. Amounts are in the shared
/// currency of both; the base amounts keep receivables exact to the paisa.
model ReceiptAllocation {
  id               String       @id @default(uuid()) @db.Uuid
  receiptId        String       @db.Uuid
  receipt          Receipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  invoiceId        String       @db.Uuid
  invoice          SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  date             DateTime     @db.Date
  amountMinor      BigInt
  // Receivable cleared on the invoice, at the invoice's rate.
  invoiceBaseMinor BigInt
  // The same amount at the receipt's rate. The difference is exchange gain or loss.
  receiptBaseMinor BigInt
  // The journal that posted an exchange difference, for allocations made
  // after the receipt was recorded.
  journalId        String?      @unique @db.Uuid
  voidedAt         DateTime?
  createdById      String       @db.Uuid
  createdAt        DateTime     @default(now())

  @@index([receiptId])
  @@index([invoiceId])
  @@map("receipt_allocations")
}

enum VendorKind {
  COMPANY
  INDIVIDUAL
}

/// A supplier HMBL buys from: crew agencies, rental houses, venues, freelancers.
/// Shared by every entity, like clients.
model Vendor {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  normalizedName    String
  legalName         String?
  kind              VendorKind   @default(COMPANY)
  email             String?
  phone             String?
  gstin             String?
  // Permanent Account Number, needed to deduct TDS at the normal rate.
  pan               String?
  // MSME (Udyam) registration: such suppliers must be paid within 45 days.
  msmeNumber        String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  // For India, the GST state, which decides CGST + SGST or IGST on bills.
  region            String?
  postalCode        String?
  countryCode       String       @db.Char(2)
  currency          String       @db.Char(3)
  paymentTermsDays  Int          @default(30)
  // TDS usually deducted on this vendor's bills, such as 194C at 2%.
  tdsSection        String?
  tdsRateBps        Int?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  notes             String?
  status            RecordStatus @default(ACTIVE)
  isDemo            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bills                VendorBill[]
  payments             VendorPayment[]
  crew                 CrewMember[]
  equipmentPurchases   EquipmentAsset[]
  equipmentMaintenance EquipmentMaintenance[]
  purchaseOrders       PurchaseOrder[]
  travelBookings       TravelBooking[]
  shipments            Shipment[]

  portalInvitations PortalInvitation[]
  portalAccounts    PortalAccount[]

  @@index([normalizedName])
  @@index([status, name])
  @@map("vendors")
}

enum BillStatus {
  DRAFT
  SUBMITTED
  APPROVED
  VOIDED
  DISCARDED
}

/// A supplier's invoice to HMBL. Entered by Finance, approved by the project
/// manager (or Finance when it has no project), posted when approved.
model VendorBill {
  id                  String      @id @default(uuid()) @db.Uuid
  legalEntityId       String      @db.Uuid
  legalEntity         LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  // HMBL's own number, given when approved.
  number              String?
  status              BillStatus  @default(DRAFT)
  vendorId            String      @db.Uuid
  vendor              Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // The number on the supplier's invoice.
  vendorInvoiceNumber String
  billDate            DateTime    @db.Date
  dueDate             DateTime    @db.Date
  currency            String      @db.Char(3)
  fxRate              Decimal?    @db.Decimal(18, 8)
  supplyType          SupplyType
  vendorGstin         String?
  notes               String?
  subtotalMinor       BigInt      @default(0)
  cgstMinor           BigInt      @default(0)
  sgstMinor           BigInt      @default(0)
  igstMinor           BigInt      @default(0)
  otherTaxMinor       BigInt      @default(0)
  taxMinor            BigInt      @default(0)
  totalMinor          BigInt      @default(0)
  // Income tax withheld from the supplier and paid to the government.
  tdsSection          String?
  tdsRateBps          Int         @default(0)
  tdsMinor            BigInt      @default(0)
  // What HMBL owes the supplier: total less TDS.
  payableMinor        BigInt      @default(0)
  // Payable in the base currency, as posted.
  basePayableMinor    BigInt      @default(0)
  journalId           String?     @unique @db.Uuid
  submittedAt         DateTime?
  submittedById       String?     @db.Uuid
  approvedAt          DateTime?
  approvedById        String?     @db.Uuid
  rejectedReason      String?
  voidDate            DateTime?   @db.Date
  voidedAt            DateTime?
  voidReason          String?
  createdById         String      @db.Uuid
  isDemo              Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  lines          VendorBillLine[]
  allocations    VendorPaymentAllocation[]
  crewSettlement CrewSettlement?

  @@unique([legalEntityId, number])
  @@index([vendorId])
  @@index([legalEntityId, status])
  @@map("vendor_bills")
}

model VendorBillLine {
  id                  String             @id @default(uuid()) @db.Uuid
  billId              String             @db.Uuid
  bill                VendorBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  position            Int
  description         String
  sacCode             String?
  quantity            Decimal            @db.Decimal(12, 3)
  unitPriceMinor      BigInt
  amountMinor         BigInt
  taxRateId           String?            @db.Uuid
  taxCode             String?
  taxRateBps          Int                @default(0)
  cgstMinor           BigInt             @default(0)
  sgstMinor           BigInt             @default(0)
  igstMinor           BigInt             @default(0)
  otherTaxMinor       BigInt             @default(0)
  taxMinor            BigInt             @default(0)
  totalMinor          BigInt
  // Whether the GST can be claimed as input tax credit; if not it is part of the cost.
  itcEligible         Boolean            @default(true)
  // The expense or asset account the cost goes to.
  accountId           String             @db.Uuid
  account             LedgerAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  projectId           String?            @db.Uuid
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  budgetLineId        String?            @db.Uuid
  // The project actual cost this line posted when approved.
  costEntryId         String?            @unique @db.Uuid
  // The project commitment (a crew booking, a purchase order line) this line
  // bills, so its actual cost draws the commitment down instead of adding to it.
  commitmentId        String?            @db.Uuid
  // The purchase order line this line bills, for matching against what was
  // ordered and received.
  purchaseOrderLineId String?            @db.Uuid
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@unique([billId, position])
  @@index([purchaseOrderLineId])
  @@map("vendor_bill_lines")
}

enum PaymentStatus {
  POSTED
  VOIDED
}

/// Money paid to a supplier from a bank or cash account.
model VendorPayment {
  id            String        @id @default(uuid()) @db.Uuid
  legalEntityId String        @db.Uuid
  legalEntity   LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  number        String
  status        PaymentStatus @default(POSTED)
  vendorId      String        @db.Uuid
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  paidFromId    String        @db.Uuid
  paidFrom      LedgerAccount @relation(fields: [paidFromId], references: [id], onDelete: Restrict)
  date          DateTime      @db.Date
  method        PaymentMethod
  reference     String?
  currency      String        @db.Char(3)
  fxRate        Decimal?      @db.Decimal(18, 8)
  amountMinor   BigInt
  baseMinor     BigInt
  notes         String?
  journalId     String        @unique @db.Uuid
  voidDate      DateTime?     @db.Date
  voidedAt      DateTime?
  voidedById    String?       @db.Uuid
  voidReason    String?
  createdById   String        @db.Uuid
  isDemo        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  allocations VendorPaymentAllocation[]

  @@unique([legalEntityId, number])
  @@index([vendorId])
  @@map("vendor_payments")
}

/// Part of a payment applied to a bill, with both base amounts like receipt allocations.
model VendorPaymentAllocation {
  id               String        @id @default(uuid()) @db.Uuid
  paymentId        String        @db.Uuid
  payment          VendorPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  billId           String        @db.Uuid
  bill             VendorBill    @relation(fields: [billId], references: [id], onDelete: Restrict)
  date             DateTime      @db.Date
  amountMinor      BigInt
  billBaseMinor    BigInt
  paymentBaseMinor BigInt
  journalId        String?       @unique @db.Uuid
  voidedAt         DateTime?
  createdById      String        @db.Uuid
  createdAt        DateTime      @default(now())

  @@index([paymentId])
  @@index([billId])
  @@map("vendor_payment_allocations")
}

// ─── Expenses and advances (docs/expenses.md) ──────────────────────────────

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  VOIDED
  DISCARDED
}

enum AdvanceStatus {
  POSTED
  VOIDED
}

enum SettlementKind {
  ADVANCE
  PAYMENT
}

/// What staff spend money on, with the account it is charged to and a policy limit.
model ExpenseCategory {
  id              String       @id @default(uuid()) @db.Uuid
  key             String       @unique
  name            String
  // The account in each entity's chart that this category is charged to.
  accountCode     String
  // The most one line may claim, in limitCurrency; more needs a reason.
  limitMinor      BigInt?
  limitCurrency   String?      @db.Char(3)
  // Whether each line needs a receipt attached; without one it needs a reason.
  receiptRequired Boolean      @default(true)
  position        Int          @default(0)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lines ExpenseClaimLine[]

  @@map("expense_categories")
}

/// Money given to a member of staff or crew ahead of spending it.
model StaffAdvance {
  id            String        @id @default(uuid()) @db.Uuid
  legalEntityId String        @db.Uuid
  legalEntity   LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  number        String
  status        AdvanceStatus @default(POSTED)
  personId      String        @db.Uuid
  person        User          @relation("StaffAdvancePerson", fields: [personId], references: [id], onDelete: Restrict)
  projectId     String?       @db.Uuid
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  purpose       String
  date          DateTime      @db.Date
  currency      String        @db.Char(3)
  amountMinor   BigInt
  paidFromId    String        @db.Uuid
  paidFrom      LedgerAccount @relation(fields: [paidFromId], references: [id], onDelete: Restrict)
  method        PaymentMethod
  reference     String?
  journalId     String        @unique @db.Uuid
  voidDate      DateTime?     @db.Date
  voidedAt      DateTime?
  voidReason    String?
  createdById   String        @db.Uuid
  isDemo        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  settlements ExpenseSettlement[]
  returns     AdvanceReturn[]

  @@unique([legalEntityId, number])
  @@index([personId])
  @@map("staff_advances")
}

/// Unspent advance money handed back.
model AdvanceReturn {
  id               String        @id @default(uuid()) @db.Uuid
  advanceId        String        @db.Uuid
  advance          StaffAdvance  @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  date             DateTime      @db.Date
  amountMinor      BigInt
  depositAccountId String        @db.Uuid
  depositAccount   LedgerAccount @relation(fields: [depositAccountId], references: [id], onDelete: Restrict)
  reference        String?
  journalId        String        @unique @db.Uuid
  createdById      String        @db.Uuid
  createdAt        DateTime      @default(now())

  @@index([advanceId])
  @@map("advance_returns")
}

/// A claim for money a member of staff or crew spent on HMBL's behalf.
model ExpenseClaim {
  id             String             @id @default(uuid()) @db.Uuid
  legalEntityId  String             @db.Uuid
  legalEntity    LegalEntity        @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  // Given when first submitted.
  number         String?
  status         ExpenseClaimStatus @default(DRAFT)
  claimantId     String             @db.Uuid
  claimant       User               @relation("ExpenseClaimant", fields: [claimantId], references: [id], onDelete: Restrict)
  title          String
  currency       String             @db.Char(3)
  totalMinor     BigInt             @default(0)
  notes          String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?            @db.Uuid
  rejectedReason String?
  journalId      String?            @unique @db.Uuid
  voidDate       DateTime?          @db.Date
  voidedAt       DateTime?
  voidReason     String?
  createdById    String             @db.Uuid
  isDemo         Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines       ExpenseClaimLine[]
  receipts    ExpenseReceipt[]
  settlements ExpenseSettlement[]

  @@unique([legalEntityId, number])
  @@index([claimantId])
  @@index([status])
  @@map("expense_claims")
}

model ExpenseClaimLine {
  id               String          @id @default(uuid()) @db.Uuid
  claimId          String          @db.Uuid
  claim            ExpenseClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  position         Int
  date             DateTime        @db.Date
  categoryId       String          @db.Uuid
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description      String
  merchant         String?
  accountId        String          @db.Uuid
  account          LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  projectId        String?         @db.Uuid
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  budgetLineId     String?         @db.Uuid
  // In the claim's currency, as reimbursed.
  amountMinor      BigInt
  // What was actually spent when abroad, for reference.
  spentCurrency    String?         @db.Char(3)
  spentAmountMinor BigInt?
  // Policy flags worked out when submitted, and the claimant's reason.
  overLimit        Boolean         @default(false)
  missingReceipt   Boolean         @default(false)
  policyNote       String?
  costEntryId      String?         @db.Uuid

  receipts ExpenseReceipt[]

  @@index([claimId])
  @@index([projectId])
  @@map("expense_claim_lines")
}

/// A photo or scan of a receipt, stored like project documents.
model ExpenseReceipt {
  id           String            @id @default(uuid()) @db.Uuid
  claimId      String            @db.Uuid
  claim        ExpenseClaim      @relation(fields: [claimId], references: [id], onDelete: Restrict)
  lineId       String?           @db.Uuid
  line         ExpenseClaimLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  fileName     String
  contentType  String
  sizeBytes    BigInt
  sha256       String
  storageKey   String            @unique
  uploadedById String            @db.Uuid
  createdAt    DateTime          @default(now())

  @@index([claimId])
  @@map("expense_receipts")
}

/// Part of an approved claim settled from an advance or paid out.
model ExpenseSettlement {
  id          String         @id @default(uuid()) @db.Uuid
  claimId     String         @db.Uuid
  claim       ExpenseClaim   @relation(fields: [claimId], references: [id], onDelete: Restrict)
  kind        SettlementKind
  advanceId   String?        @db.Uuid
  advance     StaffAdvance?  @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  paidFromId  String?        @db.Uuid
  paidFrom    LedgerAccount? @relation(fields: [paidFromId], references: [id], onDelete: Restrict)
  date        DateTime       @db.Date
  amountMinor BigInt
  reference   String?
  journalId   String         @unique @db.Uuid
  voidDate    DateTime?      @db.Date
  voidedAt    DateTime?
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now())

  @@index([claimId])
  @@index([advanceId])
  @@map("expense_settlements")
}

// ─── Finance: bank statements and reconciliation ─────────────────────────────
// Statement lines are imported from the bank's CSV or typed in, matched to
// ledger lines on the bank account, and locked by completed reconciliations
// (docs/banking.md). Amounts are signed in the bank account's currency.

enum BankStatementSource {
  CSV
  MANUAL
}

enum BankMatchKind {
  STATEMENT
  // Cleared as part of the opening balance of the first statement.
  OPENING
}

enum BankReconciliationStatus {
  COMPLETED
  REOPENED
}

model BankStatementImport {
  id            String              @id @default(uuid()) @db.Uuid
  bankAccountId String              @db.Uuid
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  source        BankStatementSource
  fileName      String?
  sha256        String?
  lineCount     Int
  skippedCount  Int                 @default(0)
  importedById  String              @db.Uuid
  createdAt     DateTime            @default(now())
  lines         BankStatementLine[]

  @@index([bankAccountId])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id            String              @id @default(uuid()) @db.Uuid
  bankAccountId String              @db.Uuid
  bankAccount   BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  importId      String              @db.Uuid
  import        BankStatementImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  date          DateTime            @db.Date
  description   String
  reference     String?
  amountMinor   BigInt
  balanceMinor  BigInt?
  dedupeKey     String
  createdAt     DateTime            @default(now())
  matches       BankMatch[]

  @@unique([bankAccountId, dedupeKey])
  @@index([bankAccountId, date])
  @@map("bank_statement_lines")
}

model BankMatch {
  id              String             @id @default(uuid()) @db.Uuid
  bankAccountId   String             @db.Uuid
  bankAccount     BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  kind            BankMatchKind
  statementLineId String?            @db.Uuid
  statementLine   BankStatementLine? @relation(fields: [statementLineId], references: [id], onDelete: Restrict)
  // A ledger line clears once.
  journalLineId   String             @unique @db.Uuid
  journalLine     JournalLine        @relation(fields: [journalLineId], references: [id], onDelete: Restrict)
  amountMinor     BigInt
  createdById     String             @db.Uuid
  createdAt       DateTime           @default(now())

  @@index([bankAccountId])
  @@index([statementLineId])
  @@map("bank_matches")
}

model BankReconciliation {
  id                    String                   @id @default(uuid()) @db.Uuid
  bankAccountId         String                   @db.Uuid
  bankAccount           BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  statementDate         DateTime                 @db.Date
  statementBalanceMinor BigInt
  status                BankReconciliationStatus @default(COMPLETED)
  completedById         String                   @db.Uuid
  completedAt           DateTime                 @default(now())
  reopenedById          String?                  @db.Uuid
  reopenedAt            DateTime?
  reopenReason          String?

  @@index([bankAccountId, statementDate])
  @@map("bank_reconciliations")
}

// ─── Crew and freelancers (docs/crew.md) ────────────────────────────────────
// Group-wide, like clients and vendors: the same people work for every entity.
// Rates, emergency contacts and payment links need crew.view_sensitive.

enum CrewKind {
  EMPLOYEE
  FREELANCER
}

enum CrewRateType {
  DAY
  HALF_DAY
  OVERTIME_HOUR
}

/// Someone HMBL puts on projects: a member of staff or a freelancer.
model CrewMember {
  id                       String       @id @default(uuid()) @db.Uuid
  name                     String
  normalizedName           String
  kind                     CrewKind
  // Staff who sign in to HMBL OS.
  userId                   String?      @unique @db.Uuid
  user                     User?        @relation("CrewMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  // The vendor record a freelancer is paid through (bank details, PAN, TDS).
  vendorId                 String?      @db.Uuid
  vendor                   Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  email                    String?
  phone                    String?
  // Where they are based, and where else they will work, one per line.
  baseCity                 String?
  preferredLocations       String?
  // Roles and skills, such as "Lighting operator" or "Rigging".
  skills                   String[]
  // Contract, NDA or agreement reference, kept with the documents.
  contractRef              String?
  notes                    String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  status                   RecordStatus @default(ACTIVE)
  isDemo                   Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  rates          CrewRate[]
  certifications CrewCertification[]
  unavailability CrewUnavailability[]
  assignments    CrewAssignment[]
  settlements    CrewSettlement[]
  travel         TravelTraveller[]

  portalInvitations PortalInvitation[]
  portalAccounts    PortalAccount[]

  @@index([normalizedName])
  @@index([status, name])
  @@map("crew_members")
}

/// What a crew member is paid, before tax. A rate for a role beats a rate for
/// any role; rates are replaced by ending the old one, never edited.
model CrewRate {
  id           String       @id @default(uuid()) @db.Uuid
  crewMemberId String       @db.Uuid
  crewMember   CrewMember   @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  // Null applies to every role.
  role         String?
  type         CrewRateType
  currency     String       @db.Char(3)
  amountMinor  BigInt
  validFrom    DateTime     @db.Date
  validTo      DateTime?    @db.Date
  notes        String?
  createdById  String       @db.Uuid
  createdAt    DateTime     @default(now())

  @@index([crewMemberId])
  @@map("crew_rates")
}

/// A licence, ticket or qualification, such as working at height or a rigging card.
model CrewCertification {
  id           String     @id @default(uuid()) @db.Uuid
  crewMemberId String     @db.Uuid
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  name         String
  issuer       String?
  reference    String?
  issuedOn     DateTime?  @db.Date
  expiresOn    DateTime?  @db.Date
  createdById  String     @db.Uuid
  createdAt    DateTime   @default(now())

  @@index([crewMemberId])
  @@map("crew_certifications")
}

/// Days a crew member can't work: leave, another job, travel.
model CrewUnavailability {
  id           String     @id @default(uuid()) @db.Uuid
  crewMemberId String     @db.Uuid
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  startDate    DateTime   @db.Date
  endDate      DateTime   @db.Date
  reason       String?
  createdById  String     @db.Uuid
  createdAt    DateTime   @default(now())

  @@index([crewMemberId, startDate])
  @@map("crew_unavailability")
}

enum CrewAssignmentStatus {
  // Asked, not yet agreed.
  PROPOSED
  CONFIRMED
  // The person said no.
  DECLINED
  // HMBL called it off, or replaced the person.
  CANCELLED
}

enum CrewWorkDay {
  FULL
  HALF
}

/// A named person booked on a project, usually against a crew requirement.
/// The rates are copied when booked; a confirmed freelancer with a budget
/// line commits their cost to the project.
model CrewAssignment {
  id                String                      @id @default(uuid()) @db.Uuid
  projectId         String                      @db.Uuid
  project           Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requirementId     String?                     @db.Uuid
  requirement       ProjectResourceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  crewMemberId      String                      @db.Uuid
  crewMember        CrewMember                  @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  role              String
  startDate         DateTime                    @db.Date
  endDate           DateTime                    @db.Date
  status            CrewAssignmentStatus        @default(PROPOSED)
  budgetLineId      String?                     @db.Uuid
  // In the project's currency, before tax.
  currency          String                      @db.Char(3)
  dayRateMinor      BigInt?
  halfDayRateMinor  BigInt?
  overtimeRateMinor BigInt?
  callTime          String?
  reportTo          String?
  notes             String?
  // A clash with another booking or time off, confirmed anyway with crew.approve.
  overrideReason    String?
  overrideById      String?                     @db.Uuid
  overrideAt        DateTime?
  // The booking this one replaced.
  replacesId        String?                     @unique @db.Uuid
  replaces          CrewAssignment?             @relation("CrewSubstitution", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy        CrewAssignment?             @relation("CrewSubstitution")
  // The project commitment for a confirmed freelancer.
  commitmentId      String?                     @unique @db.Uuid
  confirmedAt       DateTime?
  confirmedById     String?                     @db.Uuid
  endedReason       String?
  endedAt           DateTime?
  createdById       String                      @db.Uuid
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  workRecords CrewWorkRecord[]

  @@index([crewMemberId, startDate])
  @@index([projectId])
  @@map("crew_assignments")
}

/// A day worked on an assignment: a full or half day, overtime and money
/// spent. Approved by the project, then settled.
model CrewWorkRecord {
  id              String          @id @default(uuid()) @db.Uuid
  assignmentId    String          @db.Uuid
  assignment      CrewAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  date            DateTime        @db.Date
  day             CrewWorkDay     @default(FULL)
  overtimeMinutes Int             @default(0)
  // Reimbursable money spent, in the assignment's currency.
  expensesMinor   BigInt          @default(0)
  notes           String?
  approvedAt      DateTime?
  approvedById    String?         @db.Uuid
  settlementId    String?         @db.Uuid
  settlement      CrewSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdById     String          @db.Uuid
  createdAt       DateTime        @default(now())

  @@unique([assignmentId, date])
  @@index([settlementId])
  @@map("crew_work_records")
}

/// Approved work for one freelancer in one entity, turned into a draft vendor
/// bill to the vendor they are paid through. Released if the bill is discarded or voided.
model CrewSettlement {
  id            String     @id @default(uuid()) @db.Uuid
  legalEntityId String     @db.Uuid
  crewMemberId  String     @db.Uuid
  crewMember    CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  billId        String     @unique @db.Uuid
  bill          VendorBill @relation(fields: [billId], references: [id], onDelete: Restrict)
  currency      String     @db.Char(3)
  totalMinor    BigInt
  releasedAt    DateTime?
  createdById   String     @db.Uuid
  createdAt     DateTime   @default(now())

  workRecords CrewWorkRecord[]

  @@index([crewMemberId])
  @@map("crew_settlements")
}

// ─── Equipment (spec §13, docs/equipment.md) ─────────────────────────────────

/// Serialised items are tracked one asset at a time; quantity items as stock
/// counts per location, such as cables or clamps.
enum EquipmentTracking {
  SERIALISED
  QUANTITY
}

enum EquipmentOwnership {
  OWNED
  LEASED
}

/// Whether an asset can go out. Only return-to-service approval makes an
/// out-of-service asset available again.
enum EquipmentAssetState {
  AVAILABLE
  OUT_OF_SERVICE
  LOST
  RETIRED
}

enum EquipmentCondition {
  GOOD
  FAIR
  DAMAGED
}

enum EquipmentMaintenanceKind {
  SCHEDULED
  FAULT
  REPAIR
  INSPECTION
}

enum EquipmentMaintenanceStatus {
  OPEN
  DONE
  CANCELLED
}

enum EquipmentStockMovementKind {
  ADDED
  REMOVED
  TRANSFERRED
  OUT_OF_SERVICE
  RETURNED_TO_SERVICE
  DISPATCHED
  RETURNED
}

model EquipmentCategory {
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String       @unique
  description            String?
  // How often items in it are inspected, and what an inspection checks.
  inspectionIntervalDays Int?
  inspectionChecklist    String[]
  status                 RecordStatus @default(ACTIVE)
  isDemo                 Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  items EquipmentItem[]

  @@map("equipment_categories")
}

/// A kind of equipment HMBL holds, such as "Robe MegaPointe" or "16A cable 10 m".
model EquipmentItem {
  id                    String            @id @default(uuid()) @db.Uuid
  sku                   String            @unique
  name                  String
  categoryId            String            @db.Uuid
  category              EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tracking              EquipmentTracking
  manufacturer          String?
  model                 String?
  description           String?
  // Per day, before tax, in `currency`: what HMBL charges, what it costs
  // HMBL internally (informational, never posted), and what replacing one costs.
  currency              String            @db.Char(3)
  rentalDayRateMinor    BigInt?
  internalDayCostMinor  BigInt?
  replacementValueMinor BigInt?
  notes                 String?
  status                RecordStatus      @default(ACTIVE)
  isDemo                Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  assets         EquipmentAsset[]
  stock          EquipmentStock[]
  stockMovements EquipmentStockMovement[]
  kitComponents  EquipmentKitComponent[]
  maintenance    EquipmentMaintenance[]

  bookings EquipmentBooking[]

  @@index([categoryId])
  @@index([status, name])
  @@map("equipment_items")
}

/// One serialised unit.
model EquipmentAsset {
  id                String              @id @default(uuid()) @db.Uuid
  itemId            String              @db.Uuid
  item              EquipmentItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  assetTag          String              @unique
  serialNumber      String?
  ownership         EquipmentOwnership  @default(OWNED)
  // The company that owns or leases it.
  legalEntityId     String?             @db.Uuid
  legalEntity       LegalEntity?        @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  locationId        String?             @db.Uuid
  location          Location?           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  state             EquipmentAssetState @default(AVAILABLE)
  condition         EquipmentCondition  @default(GOOD)
  stateReason       String?
  purchasedOn       DateTime?           @db.Date
  purchaseCostMinor BigInt?
  purchaseCurrency  String?             @db.Char(3)
  purchasedFromId   String?             @db.Uuid
  purchasedFrom     Vendor?             @relation(fields: [purchasedFromId], references: [id], onDelete: Restrict)
  purchaseReference String?
  warrantyUntil     DateTime?           @db.Date
  lastInspectedOn   DateTime?           @db.Date
  nextInspectionDue DateTime?           @db.Date
  notes             String?
  isDemo            Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  maintenance EquipmentMaintenance[]

  allocations EquipmentAllocation[]

  @@unique([itemId, serialNumber])
  @@index([itemId, state])
  @@map("equipment_assets")
}

/// How many of a quantity item a location holds, and how many of those are out of service.
model EquipmentStock {
  id                   String        @id @default(uuid()) @db.Uuid
  itemId               String        @db.Uuid
  item                 EquipmentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId           String        @db.Uuid
  location             Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantity             Int           @default(0)
  outOfServiceQuantity Int           @default(0)
  updatedAt            DateTime      @updatedAt

  @@unique([itemId, locationId])
  @@map("equipment_stock")
}

/// Every change to stock, append-only.
model EquipmentStockMovement {
  id                 String                     @id @default(uuid()) @db.Uuid
  itemId             String                     @db.Uuid
  item               EquipmentItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  locationId         String                     @db.Uuid
  location           Location                   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  kind               EquipmentStockMovementKind
  // Change to the quantity held, and to the quantity out of service.
  quantityChange     Int                        @default(0)
  outOfServiceChange Int                        @default(0)
  reason             String
  maintenanceId      String?                    @db.Uuid
  createdById        String                     @db.Uuid
  createdAt          DateTime                   @default(now())

  @@index([itemId, createdAt])
  @@map("equipment_stock_movements")
}

/// A bundle booked as one, such as "Wireless mic kit".
model EquipmentKit {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  components EquipmentKitComponent[]

  bookings EquipmentBooking[]

  @@map("equipment_kits")
}

model EquipmentKitComponent {
  id       String        @id @default(uuid()) @db.Uuid
  kitId    String        @db.Uuid
  kit      EquipmentKit  @relation(fields: [kitId], references: [id], onDelete: Cascade)
  itemId   String        @db.Uuid
  item     EquipmentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity Int

  @@unique([kitId, itemId])
  @@map("equipment_kit_components")
}

/// Scheduled maintenance, a fault, a repair or an inspection, on one asset or
/// on a quantity of a stock item at a location.
model EquipmentMaintenance {
  id                    String                     @id @default(uuid()) @db.Uuid
  itemId                String                     @db.Uuid
  item                  EquipmentItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  assetId               String?                    @db.Uuid
  asset                 EquipmentAsset?            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  locationId            String?                    @db.Uuid
  location              Location?                  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantity              Int                        @default(1)
  kind                  EquipmentMaintenanceKind
  status                EquipmentMaintenanceStatus @default(OPEN)
  title                 String
  details               String?
  // Took the equipment out of service when reported.
  takesOutOfService     Boolean                    @default(false)
  // Planned downtime: the equipment can't be booked over these days.
  blockFrom             DateTime?                  @db.Date
  blockTo               DateTime?                  @db.Date
  // Inspection checks: [{ label, passed }] once done.
  checklist             Json?
  passed                Boolean?
  outcome               String?
  costMinor             BigInt?
  currency              String?                    @db.Char(3)
  vendorId              String?                    @db.Uuid
  vendor                Vendor?                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  reportedById          String                     @db.Uuid
  reportedAt            DateTime                   @default(now())
  completedById         String?                    @db.Uuid
  completedAt           DateTime?
  returnedToServiceById String?                    @db.Uuid
  returnedToServiceAt   DateTime?

  @@index([assetId, status])
  @@index([itemId, status])
  @@index([status, kind])
  @@map("equipment_maintenance")
}

enum EquipmentBookingStatus {
  RESERVED
  CLOSED
  CANCELLED
}

/// Equipment reserved for a project: a quantity of one item over a run of
/// days, usually against one of the project's equipment requirements. What
/// went out and came back is counted on the booking; serialised items also
/// name each asset (EquipmentAllocation).
model EquipmentBooking {
  id                 String                      @id @default(uuid()) @db.Uuid
  projectId          String                      @db.Uuid
  project            Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requirementId      String?                     @db.Uuid
  requirement        ProjectResourceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  itemId             String                      @db.Uuid
  item               EquipmentItem               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // Booked as part of a kit.
  kitId              String?                     @db.Uuid
  kit                EquipmentKit?               @relation(fields: [kitId], references: [id], onDelete: Restrict)
  quantity           Int
  startDate          DateTime                    @db.Date
  endDate            DateTime                    @db.Date
  status             EquipmentBookingStatus      @default(RESERVED)
  dispatchedQuantity Int                         @default(0)
  returnedQuantity   Int                         @default(0)
  damagedQuantity    Int                         @default(0)
  lostQuantity       Int                         @default(0)
  // Reserved beyond what is free, approved with equipment.approve.
  shortfall          Int                         @default(0)
  overrideReason     String?
  overrideById       String?                     @db.Uuid
  notes              String?
  closedReason       String?
  closedAt           DateTime?
  createdById        String                      @db.Uuid
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  allocations EquipmentAllocation[]
  movements   EquipmentBookingMovement[]
  shipments   ShipmentEquipment[]

  @@index([itemId, startDate])
  @@index([projectId])
  @@map("equipment_bookings")
}

/// One asset given to a booking. A database exclusion constraint stops the
/// same asset being held by two bookings on the same day.
model EquipmentAllocation {
  id              String              @id @default(uuid()) @db.Uuid
  bookingId       String              @db.Uuid
  booking         EquipmentBooking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  assetId         String              @db.Uuid
  asset           EquipmentAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  startDate       DateTime            @db.Date
  endDate         DateTime            @db.Date
  dispatchedAt    DateTime?
  dispatchedById  String?             @db.Uuid
  returnedAt      DateTime?
  returnedById    String?             @db.Uuid
  returnCondition EquipmentCondition?
  lost            Boolean             @default(false)
  returnNotes     String?
  // Set once it stops holding the asset: returned, lost or taken off the booking.
  releasedAt      DateTime?
  createdAt       DateTime            @default(now())

  @@index([assetId])
  @@index([bookingId])
  @@map("equipment_allocations")
}

enum EquipmentBookingMovementKind {
  DISPATCHED
  RETURNED
}

/// Each dispatch or return of a booking's equipment: how many, from or to
/// where, and in what state they came back.
model EquipmentBookingMovement {
  id          String                       @id @default(uuid()) @db.Uuid
  bookingId   String                       @db.Uuid
  booking     EquipmentBooking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  kind        EquipmentBookingMovementKind
  locationId  String?                      @db.Uuid
  location    Location?                    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantity    Int                          @default(0)
  damaged     Int                          @default(0)
  lost        Int                          @default(0)
  notes       String?
  createdById String                       @db.Uuid
  createdAt   DateTime                     @default(now())

  @@index([bookingId])
  @@map("equipment_booking_movements")
}

// ─── Procurement ─────────────────────────────────────────────────────────────

/// An entity's purchasing rules.
model ProcurementSettings {
  legalEntityId          String      @id @db.Uuid
  legalEntity            LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  // Orders above this total (base currency, before tax) need approval; at or
  // below it they are approved when submitted. Orders in another currency
  // always need approval.
  approvalThresholdMinor BigInt      @default(0)
  updatedAt              DateTime    @updatedAt

  @@map("procurement_settings")
}

enum PurchaseOrderKind {
  SERVICES
  RENTAL
  CONSUMABLES
  EQUIPMENT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  AMENDING
  CLOSED
  CANCELLED
}

/// An order to a vendor for one project or cost centre. Numbered when first
/// approved; each approved version is kept as a revision.
model PurchaseOrder {
  id                    String              @id @default(uuid()) @db.Uuid
  legalEntityId         String              @db.Uuid
  legalEntity           LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  number                String?
  kind                  PurchaseOrderKind
  status                PurchaseOrderStatus @default(DRAFT)
  vendorId              String              @db.Uuid
  vendor                Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // Exactly one of a project or a cost centre.
  projectId             String?             @db.Uuid
  project               Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  costCentreId          String?             @db.Uuid
  costCentre            CostCentre?         @relation(fields: [costCentreId], references: [id], onDelete: Restrict)
  currency              String              @db.Char(3)
  supplyType            SupplyType
  requiredDate          DateTime?           @db.Date
  // The hire period, for rentals.
  hireFrom              DateTime?           @db.Date
  hireTo                DateTime?           @db.Date
  deliveryLocationId    String?             @db.Uuid
  deliveryLocation      Location?           @relation(fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  deliveryNotes         String?
  terms                 String?
  notes                 String?
  subtotalMinor         BigInt              @default(0)
  taxMinor              BigInt              @default(0)
  totalMinor            BigInt              @default(0)
  // 0 until first approved; each approval of an amendment adds one.
  revision              Int                 @default(0)
  // The subtotal last approved, against which amendments are measured.
  approvedSubtotalMinor BigInt?
  amendmentReason       String?
  submittedAt           DateTime?
  submittedById         String?             @db.Uuid
  approvedAt            DateTime?
  approvedById          String?             @db.Uuid
  rejectedReason        String?
  closedAt              DateTime?
  closedReason          String?
  createdById           String              @db.Uuid
  isDemo                Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  lines     PurchaseOrderLine[]
  revisions PurchaseOrderRevision[]
  receipts  GoodsReceipt[]

  @@unique([legalEntityId, number])
  @@index([legalEntityId, status])
  @@index([vendorId])
  @@index([projectId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String             @id @default(uuid()) @db.Uuid
  purchaseOrderId  String             @db.Uuid
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  position         Int
  description      String
  quantity         Decimal            @db.Decimal(12, 3)
  unitPriceMinor   BigInt
  amountMinor      BigInt
  taxRateId        String?            @db.Uuid
  taxRateBps       Int                @default(0)
  taxMinor         BigInt             @default(0)
  totalMinor       BigInt
  budgetLineId     String?            @db.Uuid
  budgetLine       ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  // The project commitment posted when the order is approved.
  commitmentId     String?            @db.Uuid
  receivedQuantity Decimal            @default(0) @db.Decimal(12, 3)
  // Rentals handed back to the vendor.
  returnedQuantity Decimal            @default(0) @db.Decimal(12, 3)

  billLines    VendorBillLine[]
  receiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

/// An approved version of an order, kept as it was approved.
model PurchaseOrderRevision {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  revision        Int
  snapshot        Json
  reason          String?
  subtotalMinor   BigInt
  totalMinor      BigInt
  approvedById    String        @db.Uuid
  createdAt       DateTime      @default(now())

  @@unique([purchaseOrderId, revision])
  @@map("purchase_order_revisions")
}

enum GoodsReceiptKind {
  RECEIVED
  RETURNED
}

/// Goods or services received against an order, or rentals handed back.
model GoodsReceipt {
  id              String           @id @default(uuid()) @db.Uuid
  purchaseOrderId String           @db.Uuid
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  kind            GoodsReceiptKind
  receivedOn      DateTime         @db.Date
  locationId      String?          @db.Uuid
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  reference       String?
  notes           String?
  createdById     String           @db.Uuid
  createdAt       DateTime         @default(now())

  lines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id        String            @id @default(uuid()) @db.Uuid
  receiptId String            @db.Uuid
  receipt   GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineId    String            @db.Uuid
  line      PurchaseOrderLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  quantity  Decimal           @db.Decimal(12, 3)

  @@index([lineId])
  @@map("goods_receipt_lines")
}

// ─── Travel and accommodation (spec §15) ─────────────────────────────────────

enum TravelRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  COMPLETED
  CANCELLED
}

/// A trip for a project: who travels, when, the estimate it was approved at,
/// and the budget line its bookings are paid from.
model TravelRequest {
  id             String              @id @default(uuid()) @db.Uuid
  legalEntityId  String              @db.Uuid
  legalEntity    LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  projectId      String              @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Given on approval.
  number         String?
  title          String
  status         TravelRequestStatus @default(DRAFT)
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  // Where from and to, e.g. "Guwahati → Mumbai → Guwahati".
  route          String?
  // The travel budget for this trip, before tax, in the project's currency.
  currency       String              @db.Char(3)
  estimateMinor  BigInt              @default(0)
  budgetLineId   String?             @db.Uuid
  notes          String?
  rejectedReason String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?             @db.Uuid
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdById    String              @db.Uuid
  isDemo         Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  travellers TravelTraveller[]
  bookings   TravelBooking[]

  @@unique([legalEntityId, number])
  @@index([projectId])
  @@index([legalEntityId, status])
  @@map("travel_requests")
}

/// Someone on a trip: a crew member, or a named guest such as an artist.
/// Identity document fields are sensitive (logistics.view_sensitive).
model TravelTraveller {
  id             String        @id @default(uuid()) @db.Uuid
  requestId      String        @db.Uuid
  request        TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  crewMemberId   String?       @db.Uuid
  crewMember     CrewMember?   @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  name           String
  phone          String?
  email          String?
  // Seat, meal and other preferences.
  preferences    String?
  // Sensitive: passport or ID, visa.
  documentType   String?
  documentNumber String?
  documentExpiry DateTime?     @db.Date
  nationality    String?       @db.Char(2)
  visaReference  String?
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookings TravelBookingTraveller[]

  @@unique([requestId, crewMemberId])
  @@index([crewMemberId])
  @@map("travel_travellers")
}

enum TravelBookingKind {
  FLIGHT
  RAIL
  HOTEL
  GROUND
  OTHER
}

enum TravelBookingStatus {
  // Quoted or on hold, not paid for: commits nothing.
  HELD
  CONFIRMED
  CANCELLED
}

/// A flight, train, hotel stay or ground transfer. Times are stored in UTC
/// with the zone they happen in. A confirmed booking commits its cost to the
/// trip's budget line; a cancelled one keeps only its cancellation charge.
model TravelBooking {
  id                   String              @id @default(uuid()) @db.Uuid
  requestId            String              @db.Uuid
  request              TravelRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  kind                 TravelBookingKind
  status               TravelBookingStatus @default(HELD)
  vendorId             String?             @db.Uuid
  vendor               Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // Airline, rail operator, hotel or transport company.
  provider             String?
  // PNR, confirmation or voucher number.
  reference            String?
  // Flight or train number, room type, vehicle type and registration.
  serviceDetails       String?
  fromPlace            String?
  toPlace              String?
  departAt             DateTime?
  departTimeZone       String?
  arriveAt             DateTime?
  arriveTimeZone       String?
  // Hotel nights, as calendar days in the hotel's zone.
  checkIn              DateTime?           @db.Date
  checkOut             DateTime?           @db.Date
  rooms                Int?
  address              String?
  driverName           String?
  driverPhone          String?
  // Before tax, in the trip's currency; includes change fees.
  costMinor            BigInt              @default(0)
  commitmentId         String?             @unique @db.Uuid
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  cancellationFeeMinor BigInt?
  notes                String?
  createdById          String              @db.Uuid
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  travellers TravelBookingTraveller[]
  changes    TravelBookingChange[]

  @@index([requestId])
  @@map("travel_bookings")
}

/// Who a booking is for. A hotel booking also says which room.
model TravelBookingTraveller {
  bookingId   String          @db.Uuid
  booking     TravelBooking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travellerId String          @db.Uuid
  traveller   TravelTraveller @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  room        String?

  @@id([bookingId, travellerId])
  @@index([travellerId])
  @@map("travel_booking_travellers")
}

enum TravelChangeKind {
  CHANGED
  CANCELLED
}

/// A change to a confirmed booking, with what it cost. Append-only.
model TravelBookingChange {
  id            String           @id @default(uuid()) @db.Uuid
  bookingId     String           @db.Uuid
  booking       TravelBooking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  kind          TravelChangeKind
  reason        String
  // The change or cancellation charge, already inside the new cost.
  feeMinor      BigInt           @default(0)
  fromCostMinor BigInt
  toCostMinor   BigInt
  summary       String?
  createdById   String           @db.Uuid
  createdAt     DateTime         @default(now())

  @@index([bookingId])
  @@map("travel_booking_changes")
}

// ─── Logistics (spec §15) ────────────────────────────────────────────────────

enum ShipmentKind {
  // Equipment going to or from a show.
  EQUIPMENT
  // Freight: sets, materials, merchandise.
  FREIGHT
  // A vehicle and driver for local movement.
  LOCAL_TRANSFER
}

enum ShipmentStatus {
  PLANNED
  BOOKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// A movement of equipment or freight, or a vehicle with a driver, for a
/// project. Booking it commits its cost to a budget line; every status
/// change is kept in its tracking log.
model Shipment {
  id                   String         @id @default(uuid()) @db.Uuid
  legalEntityId        String         @db.Uuid
  legalEntity          LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  projectId            String         @db.Uuid
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind                 ShipmentKind
  status               ShipmentStatus @default(PLANNED)
  title                String
  vendorId             String?        @db.Uuid
  vendor               Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  // Transport company or driver's agency, when not a vendor on file.
  carrier              String?
  // Consignment note, LR or tracking number.
  reference            String?
  vehicle              String?
  vehicleRegistration  String?
  driverName           String?
  driverPhone          String?
  fromAddress          String
  toAddress            String
  pickupAt             DateTime
  pickupTimeZone       String
  deliverBy            DateTime?
  deliverTimeZone      String?
  packages             Int?
  weightKg             Decimal?       @db.Decimal(10, 2)
  contents             String?
  // Before tax, in the project's currency.
  currency             String         @db.Char(3)
  costMinor            BigInt         @default(0)
  budgetLineId         String?        @db.Uuid
  commitmentId         String?        @unique @db.Uuid
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  receivedBy           String?
  cancelledAt          DateTime?
  cancelReason         String?
  cancellationFeeMinor BigInt?
  notes                String?
  createdById          String         @db.Uuid
  isDemo               Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  equipment ShipmentEquipment[]
  events    ShipmentEvent[]

  @@index([projectId])
  @@index([legalEntityId, status])
  @@map("shipments")
}

/// An equipment booking carried by a shipment.
model ShipmentEquipment {
  shipmentId String           @db.Uuid
  shipment   Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  bookingId  String           @db.Uuid
  booking    EquipmentBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@id([shipmentId, bookingId])
  @@index([bookingId])
  @@map("shipment_equipment")
}

/// The tracking log of a shipment: each status change, cost change and note. Append-only.
model ShipmentEvent {
  id            String         @id @default(uuid()) @db.Uuid
  shipmentId    String         @db.Uuid
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  status        ShipmentStatus
  note          String?
  // Set when the cost changed.
  fromCostMinor BigInt?
  toCostMinor   BigInt?
  createdById   String         @db.Uuid
  createdAt     DateTime       @default(now())

  @@index([shipmentId])
  @@map("shipment_events")
}

// ─── Notifications (docs/notifications.md) ─────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  // Retried until the attempts run out, then FAILED.
  RETRYING
  FAILED
  // The channel isn't set up, so nothing was sent. Never shown as delivered.
  NOT_CONFIGURED
}

/// Something a person should know: an approval waiting, a decision, a date
/// coming up. Informational only; a notification never approves anything.
/// `dedupeKey` stops the same event notifying the same person twice.
model Notification {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @db.Uuid
  user          User                   @relation("Notifications", fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  body          String?
  href          String?
  legalEntityId String?                @db.Uuid
  targetType    String?
  targetId      String?                @db.Uuid
  dedupeKey     String
  createdAt     DateTime               @default(now())
  readAt        DateTime?
  deliveries    NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// One channel's attempt to deliver a notification, with its state.
model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @db.Uuid
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// A person's choice for one kind of notification. No row: in-app on, email off.
model NotificationPreference {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @db.Uuid
  user   User    @relation("NotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
  kind   String
  inApp  Boolean @default(true)
  email  Boolean @default(false)

  @@unique([userId, kind])
  @@map("notification_preferences")
}

// ─── Portal access ────────────────────────────────────────────────────────────
// Invitations and accounts for people outside HMBL (docs/portal.md). An
// account belongs to exactly one organisation: a client (through one of its
// contacts), a vendor, or a freelancer's crew record. Everything the portal
// shows is filtered by that organisation on the server.

enum PortalKind {
  CLIENT
  VENDOR
  FREELANCER
}

enum PortalAccountStatus {
  ACTIVE
  REVOKED
}

model PortalInvitation {
  id           String         @id @default(uuid()) @db.Uuid
  kind         PortalKind
  clientId     String?        @db.Uuid
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactId    String?        @db.Uuid
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  vendorId     String?        @db.Uuid
  vendor       Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  crewMemberId String?        @db.Uuid
  crewMember   CrewMember?    @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  name         String
  // Lower case. Accepting needs this address as well as the link.
  email        String
  // What the account may do in the portal (src/server/portal/permissions.ts).
  permissions  String[]
  // SHA-256 of the secret in the link; the secret itself is never stored.
  tokenHash    String         @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  accountId    String?        @unique @db.Uuid
  account      PortalAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  createdById  String         @db.Uuid
  createdBy    User           @relation("PortalInvitedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())

  @@index([clientId])
  @@index([vendorId])
  @@index([crewMemberId])
  @@map("portal_invitations")
}

model PortalAccount {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @db.Uuid
  user         User                @relation("PortalAccountUser", fields: [userId], references: [id], onDelete: Restrict)
  kind         PortalKind
  clientId     String?             @db.Uuid
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contactId    String?             @db.Uuid
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  vendorId     String?             @db.Uuid
  vendor       Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  crewMemberId String?             @db.Uuid
  crewMember   CrewMember?         @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  permissions  String[]
  status       PortalAccountStatus @default(ACTIVE)
  revokedAt    DateTime?
  revokedById  String?             @db.Uuid
  revokedBy    User?               @relation("PortalAccountRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokeReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  invitation PortalInvitation?

  quoteResponses QuotePortalResponse[]
  submissions    PortalSubmission[]

  @@index([clientId])
  @@index([vendorId])
  @@index([crewMemberId])
  @@map("portal_accounts")
}

// ─── Client portal ────────────────────────────────────────────────────────────
// What HMBL has chosen to show a client in the portal (docs/client-portal.md).
// Nothing is visible to a client's portal accounts until it is shared here.

enum PortalShareKind {
  PROJECT
  QUOTE
  DOCUMENT
}

model PortalShare {
  id          String          @id @default(uuid()) @db.Uuid
  clientId    String          @db.Uuid
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  kind        PortalShareKind
  projectId   String?         @db.Uuid
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  quoteId     String?         @db.Uuid
  quote       Quote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  documentId  String?         @db.Uuid
  document    RecordDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  sharedById  String          @db.Uuid
  sharedBy    User            @relation("PortalSharedBy", fields: [sharedById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  revokedAt   DateTime?
  revokedById String?         @db.Uuid
  revokedBy   User?           @relation("PortalShareRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  isDemo      Boolean         @default(false)

  // One live share per record.
  @@unique([projectId], map: "portal_shares_project_live_key", where: raw("\"revokedAt\" IS NULL AND \"projectId\" IS NOT NULL"))
  @@unique([quoteId], map: "portal_shares_quote_live_key", where: raw("\"revokedAt\" IS NULL AND \"quoteId\" IS NOT NULL"))
  @@unique([documentId], map: "portal_shares_document_live_key", where: raw("\"revokedAt\" IS NULL AND \"documentId\" IS NOT NULL"))
  @@index([clientId])
  @@map("portal_shares")
}

enum PortalResponse {
  ACCEPTED
  DECLINED
}

// The client's own answer to a quotation in the portal, with what they saw.
// Append-only. This is a record of acceptance, not an electronic signature.
model QuotePortalResponse {
  id             String         @id @default(uuid()) @db.Uuid
  versionId      String         @unique @db.Uuid
  version        QuoteVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  accountId      String         @db.Uuid
  account        PortalAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  userId         String         @db.Uuid
  user           User           @relation("QuotePortalResponder", fields: [userId], references: [id], onDelete: Restrict)
  response       PortalResponse
  // The name they typed to confirm.
  typedName      String
  reason         String?
  clientPoNumber String?
  // What they were shown: the version's total, and a SHA-256 of its
  // client-facing content (lines, totals, dates, terms).
  currency       String         @db.Char(3)
  totalMinor     BigInt
  contentSha256  String
  // The statement they confirmed, word for word.
  statement      String
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())

  @@map("quote_portal_responses")
}

// Information a client sent through the portal for a shared project.
model PortalSubmission {
  id        String        @id @default(uuid()) @db.Uuid
  accountId String        @db.Uuid
  account   PortalAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  projectId String        @db.Uuid
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  subject   String
  body      String
  createdAt DateTime      @default(now())

  @@index([projectId])
  @@map("portal_submissions")
}
