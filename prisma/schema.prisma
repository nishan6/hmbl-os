// HMBL OS database schema.
// Every change goes through a reviewed migration: `pnpm db:migrate:dev --name <change>`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (tables required by Better Auth) ────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  // DISABLED users cannot start a session; existing sessions are revoked on disable.
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions Session[]
  accounts Account[]
  roles    UserRole[] @relation("UserRoles")
  grants   UserRole[] @relation("UserRoleGrantedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Roles and permissions ────────────────────────────────────────────────────

// A role is a named set of permission keys from src/server/permissions/catalog.ts.
// System roles are created by the seed/bootstrap and can be edited but not deleted.
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @db.Uuid
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
  @@map("role_permissions")
}

// A role granted to a user. With legalEntityId set, the role applies to that
// legal entity only; null means every entity, including ones added later.
model UserRole {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  roleId        String       @db.Uuid
  role          Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  legalEntityId String?      @db.Uuid
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  grantedById   String?      @db.Uuid
  grantedBy     User?        @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  // A role is granted at most once per user per scope. Two indexes because a
  // plain unique index treats NULL ("all entities") values as distinct.
  @@unique([userId, roleId, legalEntityId])
  @@unique([userId, roleId], map: "user_roles_userId_roleId_all_entities_key", where: raw("\"legalEntityId\" IS NULL"))
  @@index([userId])
  @@index([roleId])
  @@index([legalEntityId])
  @@map("user_roles")
}

// ─── Organisation structure ───────────────────────────────────────────────────
// The deployment itself is the group (HMBL Group). Shared master data never
// implies shared accounting ownership: anything financial belongs to exactly
// one legal entity.

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

// A company with its own books, tax registrations and base currency.
model LegalEntity {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  legalName    String
  tradingName  String?
  countryCode  String       @db.Char(2) // ISO 3166-1 alpha-2
  baseCurrency String       @db.Char(3) // ISO 4217
  timezone     String // IANA zone, e.g. Asia/Kolkata
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String? // State or province; for India, the GST state
  postalCode   String?
  status       RecordStatus @default(ACTIVE)
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  taxRegistrations TaxRegistration[]
  costCentres      CostCentre[]
  locations        Location[]
  userRoles        UserRole[]

  @@map("legal_entities")
}

// A tax or statutory identifier held by a legal entity (GSTIN, PAN, TAN, VAT…).
// Types are free text so new jurisdictions need configuration, not code.
model TaxRegistration {
  id            String       @id @default(uuid()) @db.Uuid
  legalEntityId String       @db.Uuid
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  type          String
  value         String
  region        String?
  validFrom     DateTime?    @db.Date
  validTo       DateTime?    @db.Date
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([legalEntityId, type, value])
  @@map("tax_registrations")
}

// A line of business (live production, broadcast, rentals…). Group-wide:
// one business unit can trade through several legal entities.
model BusinessUnit {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  costCentres CostCentre[]

  @@map("business_units")
}

// A department or team. Group-wide and optionally nested.
model Department {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  parentId  String?      @db.Uuid
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")
  status    RecordStatus @default(ACTIVE)
  isDemo    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  costCentres CostCentre[]

  @@map("departments")
}

// Where costs are collected. Always owned by one legal entity.
model CostCentre {
  id             String        @id @default(uuid()) @db.Uuid
  legalEntityId  String        @db.Uuid
  legalEntity    LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  code           String
  name           String
  businessUnitId String?       @db.Uuid
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Restrict)
  departmentId   String?       @db.Uuid
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  status         RecordStatus  @default(ACTIVE)
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([legalEntityId, code])
  @@map("cost_centres")
}

enum LocationType {
  OFFICE
  WAREHOUSE
  STUDIO
  VENUE
  OTHER
}

// An office, warehouse or equipment store, studio or regular venue.
model Location {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  name          String
  type          LocationType
  legalEntityId String?      @db.Uuid
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?
  postalCode    String?
  countryCode   String       @db.Char(2)
  timezone      String
  status        RecordStatus @default(ACTIVE)
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("locations")
}
